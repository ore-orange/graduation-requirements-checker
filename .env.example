# 設定項目の例。Railsはこのファイルを自動で読み込まない。
# ローカルDockerはcompose.ymlに設定済み。本番値はホスティング側のsecret管理へ。
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
RAILS_MAX_THREADS=5

# ローカルURLを使う場合のみ。接続先はローカル・DB名は固定（安全検査あり）。
# DEVELOPMENT_DATABASE_URL=postgresql://postgres:password@localhost:5432/grc_development
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/grc_test

# ローカルデモは開発・テスト専用。Dockerプロキシ許可はcompose.ymlに設定済み。
# LOCAL_DEMO_PROXY=1 はWebポートをloopbackに限定する場合だけ使用し、外部公開へ流用しない。

# 本番。Connect画面から取得し、secretとして登録する。秘密値をここに記載しない。
# DATABASE_URL=
# DATABASE_SSLMODE=require
# サーバー証明書検証を推奨（証明書をデプロイ先にマウントする）。
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=/run/secrets/supabase-root.crt

# 現在は別DB構成。単一Supabase DBへの集約を承認・実装するまで共通URLを設定しない。
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=
