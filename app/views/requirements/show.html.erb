<% content_for :title, app_name %>
<% content_for :full_bleed, true %>

<div class="min-h-screen bg-slate-100 pb-16 font-sans text-slate-800">
  <%= render 'shared/nav' %>

  <main class="mx-auto max-w-5xl space-y-6 px-4 pt-8 sm:px-6 lg:px-8">
    <%= render 'shared/flash' %>

    <%# 画面名はヘッダーのタブで分かるので、見出しは読み上げ用だけ残す %>
    <h2 class="sr-only">卒業要件の確認</h2>

    <%# まず対象を選ぶ。何も選ばれていないときは、この選択だけを出す %>
    <%= render 'selector' %>

    <% if @published %>
      <%= render 'published' %>
    <% elsif selection_complete? %>
      <%# 公開済みが無い。下書きがあればその続きへ、どちらも無ければ「ありません」と作り始める入口 %>
      <% if @drafts.any? %>
        <%= render 'drafts', drafts: @drafts %>
      <% else %>
        <%= render 'empty' %>
      <% end %>
    <% else %>
      <%# 選択肢にない年度・コースの便覧も、ここから作り始められる。普段は畳んでおく %>
      <details class="rounded-2xl border border-slate-200 bg-white shadow-xs" data-new-curriculum>
        <summary class="cursor-pointer px-5 py-4 text-sm font-semibold text-indigo-700 sm:px-6">
          選択肢にない年度・コースの便覧を、PDFから新しく作る
        </summary>
        <div class="px-5 pb-5 sm:px-6 sm:pb-6">
          <%= render 'upload' %>
        </div>
      </details>
    <% end %>
  </main>
</div>
