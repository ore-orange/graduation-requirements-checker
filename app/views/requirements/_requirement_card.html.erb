<%# locals: (id_attr:, name:, credits: nil, label: nil, note: nil, rules: []) %>
<%# 卒業要件の1件を、卒業ダッシュボードの区分カードと同じ殻・余白で出す。名前と単位数はどの段も左、補足は右。

    credits … その行自身の必要単位。無い（＝この行だけの単位数の制限が無い）ときは「- 単位」と出す。
              欄を空にすると、数字を読み落としたのか制限が無いのかが見分けられない。
    label … 便覧が書いている表示の言葉（required_label）。構造から作った文で置き換えず、そのまま添える。
    rules … この行を判定する決まりのカード（人文系2単位、外国語のいずれかを満たす経路など）。 %>
<li class="rounded-2xl border border-slate-200 bg-white shadow-xs" <%= tag.attributes(data: id_attr) %>>
  <div class="grid gap-4 p-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-5 sm:p-6">
    <div>
      <h4 class="text-xs font-semibold text-slate-500"><%= name %></h4>
      <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5" data-row-credits>
        <% if credits %>
          <span class="text-2xl font-extrabold tracking-tight text-slate-900 tabular-nums"><%= credit_number(credits) %></span>
          <span class="text-sm font-medium text-slate-500">単位</span>
        <% else %>
          <span class="text-2xl font-extrabold tracking-tight text-slate-400 tabular-nums"
                title="この行だけの単位数の制限はありません">-</span>
          <span class="text-sm font-medium text-slate-500">単位</span>
        <% end %>
      </p>
    </div>
    <% if note.present? || label.present? %>
      <div class="min-w-0 space-y-2 sm:border-l sm:border-slate-100 sm:pl-6">
        <% if label.present? %>
          <p><span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= label %></span></p>
        <% end %>
        <% if note.present? %>
          <p class="text-sm text-slate-600"><%= note %></p>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# この行を判定する決まり。行の数字の内訳（人文2・社会2…）や、いずれかを満たす経路がここに出る %>
  <% if rules.any? %>
    <ul class="space-y-2 border-t border-slate-100 bg-slate-50/50 p-3 sm:px-4" data-row-rules>
      <% rules.each do |card| %>
        <%= render 'requirement_rule_card', card: card %>
      <% end %>
    </ul>
  <% end %>
</li>
