<%# 公開済みの便覧の卒業要件。学生の判定に使われている文書を、そのまま見せる %>
<%
  display = @curriculum.fetch('display')
  groups = display.fetch('groups')
  rows_by_id = groups.flat_map { |group| group.fetch('rows') }.index_by { |row| row['id'] }
%>

<%# 公開済みの行は書き換えない。直すときは、複製した下書きを直して公開し、差し替える（既存の duplicate）。
    編集ボタンは、同じ年度の下書きがあっても必ず出す。差し替えると、置き換わった旧版が下書きに戻って残るので、
    下書きの有無でボタンを隠すと、1回直しただけで次の編集ができなくなる。下書きは下の欄に、事実だけを添えて並べる。 %>
<section aria-labelledby="edit-heading" data-edit-curriculum
         class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
  <div class="min-w-0">
    <h3 id="edit-heading" class="text-base font-bold text-slate-900">卒業要件を直したいとき</h3>
    <p class="mt-0.5 text-xs text-slate-500">
      公開済みの卒業要件は、そのままは書き換えません。複製した下書きを直して公開すると、差し替わります。
    </p>
  </div>
  <%= button_to 'この卒業要件を編集する', duplicate_curriculum_path(@published), method: :post, class: 'demo-button' %>
</section>

<% if @drafts.any? %>
  <%= render 'drafts', drafts: @drafts, with_published: true %>
<% end %>

<%# この画面は便覧に書かれた内容を見せるだけで、要件はここでは変えられない %>
<section aria-labelledby="total-heading"
         class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-6 sm:p-6">
  <div>
    <h3 id="total-heading" class="text-xs font-semibold text-slate-500">卒業に必要な単位</h3>
    <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5" data-total-credits>
      <span class="text-4xl font-extrabold tracking-tight text-slate-900 tabular-nums"><%= credit_number(display['total_credits']) %></span>
      <span class="text-sm font-medium text-slate-500">単位</span>
    </p>
  </div>
  <div class="min-w-0 space-y-1 sm:border-l sm:border-slate-100 sm:pl-6">
    <p class="text-sm font-semibold text-slate-900"><%= @curriculum['title'] %></p>
    <p class="text-xs text-slate-500">
      学生便覧に載っている卒業要件を、そのまま表示しています。印刷された便覧と見比べて確認できます。この画面から要件は変更できません。
    </p>
  </div>
</section>

<%# 章ごとの必要単位と、その中の区分。カードは卒業ダッシュボードの区分カード（dashboard/show）と同じ殻・余白・数字の大きさで組む。
    ダッシュボードの修得状況（バッジ・進み具合のバー・修得済み／履修中・開閉・内訳の読み込み）は、学生の進み具合に
    結びついた部品なので、便覧を見せるだけのこの画面には持ち込まない。 %>
<% groups.each do |group| %>
  <section aria-labelledby="group-<%= group['id'] %>-heading" data-group="<%= group['id'] %>" class="space-y-4">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 id="group-<%= group['id'] %>-heading" class="text-base font-bold text-slate-900"><%= group['title'] %></h3>
      <p class="text-sm font-semibold text-slate-700 tabular-nums" data-group-credits>
        <%= credit_number(group['required_credits']) %> 単位
      </p>
    </div>
    <ul class="space-y-4">
      <% group.fetch('rows').each do |row| %>
        <%= render 'requirement_card', id_attr: { row: row['id'] }, name: row['name'], credits: row['required_credits'],
                                       label: row['required_label'], note: row['subtitle'] %>
      <% end %>
    </ul>
  </section>
<% end %>

<%# 複数の行をまとめて数える小計 %>
<% subtotals = Array(display['subtotals']) %>
<% if subtotals.any? %>
  <section aria-labelledby="subtotals-heading" class="space-y-4">
    <h3 id="subtotals-heading" class="text-base font-bold text-slate-900">複数の区分をまとめて数える要件</h3>
    <ul class="space-y-4">
      <% subtotals.each do |subtotal| %>
        <%= render 'requirement_card', id_attr: { subtotal: subtotal['id'] }, name: subtotal['name'],
                                       credits: subtotal['required_credits'], label: nil,
                                       note: "対象：#{Array(subtotal['row_ids']).map { |id| rows_by_id.dig(id, 'name') || id }.join('・')}" %>
      <% end %>
    </ul>
  </section>
<% end %>

<%# 判定に使う規則。上のカードがすでに言っていること（章・行・小計が名指しして同じ単位数を出している合計など）は一覧から省き、
    カードからは読み取れない規則（系列の選択・選択経路・算入上限・算入しない・複数の区分の合計）を、便覧の順に出す。
    省いた規則も、備考と出典ページはカードに無く、印刷された便覧と見比べる手立てになるので、消さずに畳んで出す
    （科目表と同じ <details>。初めは閉じる。畳んでも HTML には入っているので、ページ内検索にも届く）。 %>
<% omitted = omitted_rules(@curriculum) %>
<section id="judgement-rules" aria-labelledby="rules-heading" class="space-y-4">
  <div class="space-y-1">
    <h3 id="rules-heading" class="text-base font-bold text-slate-900">判定の規則</h3>
    <p class="text-xs text-slate-500">
      卒業の判定はこの規則で行います。上のカードの必要単位と同じことだけを言う規則は、一覧から省いて、下の欄にまとめています。
      赤で表示された規則は、このアプリが解釈できないため、判定では要確認になります。
    </p>
  </div>

  <% if omitted.any? %>
    <details data-omitted-rules
             class="group/card rounded-2xl border border-slate-200 bg-white shadow-xs transition hover:border-indigo-300 hover:shadow-md open:border-indigo-400 open:shadow-md open:ring-1 open:ring-indigo-300">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-5 sm:px-6">
        <div class="min-w-0 space-y-1">
          <h4 class="text-xs font-semibold text-slate-500">
            上のカードと同じ内容のため省いた規則：<span class="text-sm font-extrabold text-slate-900 tabular-nums"><%= omitted.size %>件</span>
          </h4>
          <p class="text-xs text-slate-500">
            消えたわけではなく、内容は上のカードに出ています。開くと、備考と出典ページを確認できます。
          </p>
        </div>
        <%# 開閉できることは、この丸ボタンと矢印の向きで示す（科目表・ダッシュボードと同じ） %>
        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition group-hover/card:bg-indigo-100 group-hover/card:text-indigo-600 group-open/card:bg-indigo-100 group-open/card:text-indigo-600">
          <svg class="size-4 transition-transform group-open/card:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M5.5 7.5 10 12l4.5-4.5H5.5Z" />
          </svg>
        </span>
      </summary>

      <ul class="mx-5 divide-y divide-slate-100 border-t border-slate-100 pb-1 sm:mx-6">
        <% omitted.each do |rule| %>
          <%= rule_entry(rule, @curriculum, omitted: true) %>
        <% end %>
      </ul>
    </details>
  <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white shadow-xs">
    <ul data-visible-rules class="divide-y divide-slate-100 px-5 sm:px-6">
      <% visible_rules(@curriculum).each do |rule| %>
        <%= rule_entry(rule, @curriculum) %>
      <% end %>
    </ul>
  </div>
</section>

<%# 科目表。公開後の便覧の科目は、ほかのどの画面からも見られないので、ここで読み取り専用に出す %>
<%= render 'courses', curriculum: @curriculum %>
