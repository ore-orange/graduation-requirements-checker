<% content_for :title, "授業登録 | #{app_name}" %>
<div class="space-y-8">
  <header>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">授業登録</h1>
    <p class="mt-3 text-slate-600">授業時間配当表のPDFを読み取り、内容を人が確認してから授業のデータとして保存します。</p>
  </header>

  <%= render 'shared/toast' %>

  <section class="demo-panel" aria-labelledby="upload-heading">
    <h2 id="upload-heading" class="text-xl font-bold text-slate-900">PDFをアップロードする</h2>
    <div class="mt-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm leading-7 text-amber-950">
      <p class="font-bold">現時点では、知能情報コースの授業時間配当表にのみ対応しています。</p>
      <p>他の学部・共通教育などのPDFは、表の列の位置や講義コードの形式が違うため、正しく読み取れません。読み取れた場合も、必ず内容をPDFと見比べてください。</p>
    </div>
    <p class="mt-2 text-sm leading-6 text-slate-600">前期・後期でPDFが分かれているため、読み取るPDFの学期を選んでください。アップロードしただけでは授業のデータは変わりません。PDF自体は保存しません。</p>
    <%= form_with url: timetable_uploads_path, multipart: true, class: 'mt-5 flex flex-wrap items-end gap-4' do |form| %>
      <div>
        <%= form.label :semester_first, '学期', class: 'block text-sm font-semibold text-slate-700' %>
        <div class="mt-2 flex gap-4">
          <% TimetableImport::Values::SEMESTERS.each_with_index do |semester, index| %>
            <label class="flex items-center gap-2 text-slate-800">
              <%= form.radio_button :semester, semester, checked: index.zero?, id: (index.zero? ? 'semester_first' : nil) %><%= semester %>
            </label>
          <% end %>
        </div>
      </div>
      <div>
        <%= form.label :pdf, 'PDFファイル', class: 'block text-sm font-semibold text-slate-700' %>
        <%= form.file_field :pdf, accept: 'application/pdf', required: true, class: 'mt-2 block text-sm' %>
      </div>
      <%= form.submit '読み取る', class: 'demo-button' %>
    <% end %>
  </section>

  <% if @uploads.any? %>
    <section class="demo-panel" aria-labelledby="pending-heading">
      <h2 id="pending-heading" class="text-xl font-bold text-slate-900">確認中のPDF</h2>
      <ul class="mt-4 divide-y divide-slate-200">
        <% @uploads.each do |upload| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="font-semibold text-slate-900"><%= upload.source_filename %>（<%= upload.semester %>）</p>
              <p class="text-sm text-slate-600"><%= upload.rows.size %>行 / 未確認 <%= upload.unconfirmed_count %>行</p>
            </div>
            <%= link_to '確認する', upload, class: 'text-sm font-semibold text-slate-800 underline underline-offset-4' %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="demo-panel" aria-labelledby="registered-heading">
    <h2 id="registered-heading" class="text-xl font-bold text-slate-900">保存済みの授業</h2>
    <% if @offerings.empty? %>
      <p class="mt-4 rounded-lg bg-slate-50 p-4 text-slate-600">まだ保存された授業はありません。</p>
    <% else %>
      <div class="mt-4"><%= render 'shared/pagination', paginator: @paginator, path: ->(page) { course_registrations_path(page: page) } %></div>
      <% @offerings.each do |semester, offerings| %>
        <h3 class="mt-6 font-bold text-slate-900"><%= semester %></h3>
        <div class="mt-2 overflow-x-auto">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="border-b border-slate-300 text-slate-600">
              <tr><th class="py-2 pr-3">科目番号</th><th class="pr-3">科目名</th><th class="pr-3">単位</th><th class="pr-3">必修/選択</th><th class="pr-3">年次</th><th class="pr-3">曜日</th><th class="pr-3">時限</th><th>開講区分</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% offerings.each do |offering| %>
                <tr>
                  <td class="py-2 pr-3"><%= offering.course.course_number %></td>
                  <td class="pr-3"><%= offering.course.name %></td>
                  <td class="pr-3"><%= offering.course.credits %></td>
                  <td class="pr-3"><%= offering.requirement_type %></td>
                  <td class="pr-3"><%= offering.grade_years.join('・') %></td>
                  <td class="pr-3"><%= offering.weekday %></td>
                  <td class="pr-3"><%= offering.periods.join('・') %></td>
                  <td><%= offering.term_type %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
