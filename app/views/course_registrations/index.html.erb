<% content_for :title, "講義登録 | #{app_name}" %>
<div class="space-y-8" data-controller="modal">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">講義登録</h1>
      <p class="mt-3 text-slate-600">授業時間配当表のPDFを読み取り、内容を確認してから講義として保存します。</p>
    </div>
    <button type="button" data-action="modal#open" class="demo-button">講義を追加</button>
  </header>

  <%= render 'shared/toast' %>

  <dialog data-modal-target="dialog" data-action="click->modal#closeOnBackdrop" aria-labelledby="upload-heading"
          class="m-auto w-full max-w-lg rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/40">
    <%= form_with url: timetable_uploads_path, multipart: true, class: 'space-y-5 p-6', data: { controller: 'dropzone', turbo: false } do |form| %>
      <h2 id="upload-heading" class="text-xl font-bold text-slate-900">PDFから講義を追加する</h2>
      <p class="text-sm font-bold text-red-700">必ず、読み取った内容をPDFと見比べてください。</p>
      <p class="text-sm font-bold text-red-700">現時点では、知能情報コースの授業時間配当表にのみ対応しています。</p>

      <div class="grid gap-4 sm:grid-cols-2" data-controller="dependent-select">
        <label class="block">
          <span class="text-sm font-semibold text-slate-700">年度</span>
          <%= form.select :year, @year_options.map { |year| ["#{year}年度", year] }, { selected: @year_options[2] },
                          class: 'mt-1 w-full rounded border border-slate-300 bg-white px-2 py-1.5' %>
        </label>
        <div class="hidden sm:block"></div>
        <label class="block">
          <span class="text-sm font-semibold text-slate-700">開講学部</span>
          <%= form.select :faculty_id, @faculties.map { |faculty| [faculty.name, faculty.id] },
                          { include_blank: '選んでください' },
                          class: 'mt-1 w-full rounded border border-slate-300 bg-white px-2 py-1.5',
                          data: { dependent_select_target: 'parent', action: 'change->dependent-select#filter' } %>
        </label>
        <label class="block">
          <span class="text-sm font-semibold text-slate-700">開講学科</span>
          <%= form.select :department_id,
                          @faculties.map { |faculty| [faculty.name, faculty.departments.map { |d| [d.name, d.id] }] },
                          { include_blank: '選んでください' },
                          class: 'mt-1 w-full rounded border border-slate-300 bg-white px-2 py-1.5',
                          data: { dependent_select_target: 'child' } %>
        </label>
      </div>

      <fieldset>
        <legend class="text-sm font-semibold text-slate-700">学期</legend>
        <div class="mt-2 flex gap-6">
          <% TimetableImport::Values::SEMESTERS.each_with_index do |semester, index| %>
            <label class="flex items-center gap-2 text-slate-800">
              <%= form.radio_button :semester, semester, checked: index.zero? %><%= semester %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div data-dropzone-target="zone" data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
           class="rounded-xl border-2 border-dashed border-slate-300 p-6 text-center">
        <p class="text-sm text-slate-600">ここにPDFをドラッグ&ドロップ、または</p>
        <button type="button" data-action="dropzone#choose" class="mt-3 rounded-lg border border-slate-400 px-5 py-2 font-semibold text-slate-800 hover:bg-slate-50">PDFを選ぶ</button>
        <p data-dropzone-target="name" class="mt-3 text-sm text-slate-700">ファイルが選ばれていません</p>
        <%= form.file_field :pdf, accept: 'application/pdf', required: true, class: 'sr-only', tabindex: '-1',
                            data: { dropzone_target: 'input', action: 'change->dropzone#changed' } %>
      </div>

      <div class="flex justify-end gap-3">
        <button type="button" data-action="modal#close" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700">キャンセル</button>
        <%= form.submit '読み取る', class: 'demo-button' %>
      </div>
    <% end %>
  </dialog>

  <% if @uploads.any? %>
    <section class="demo-panel" aria-labelledby="pending-heading">
      <h2 id="pending-heading" class="text-xl font-bold text-slate-900">確認中のPDF</h2>
      <ul class="mt-4 divide-y divide-slate-200">
        <% @uploads.each do |upload| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="font-semibold text-slate-900"><%= upload.source_filename %></p>
              <p class="text-sm text-slate-700"><%= upload.classification_label %></p>
              <p class="text-sm text-slate-600"><%= upload.rows.size %>行 / 未確認 <%= upload.unconfirmed_count %>行</p>
            </div>
            <%= link_to '確認する', upload, class: 'text-sm font-semibold text-slate-800 underline underline-offset-4' %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="demo-panel" aria-labelledby="registered-heading">
    <h2 id="registered-heading" class="text-xl font-bold text-slate-900">保存済みの講義</h2>
    <% if @offerings.empty? %>
      <p class="mt-4 rounded-lg bg-slate-50 p-4 text-slate-600">まだ保存された講義はありません。「講義を追加」からPDFを取り込んでください。</p>
    <% else %>
      <% @offerings.each do |semester, offerings| %>
        <h3 class="mt-6 font-bold text-slate-900"><%= semester %></h3>
        <div class="mt-2 overflow-x-auto">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="border-b border-slate-300 text-slate-600">
              <tr><th class="py-2 pr-3">科目番号</th><th class="pr-3">科目名</th><th class="pr-3">単位</th><th class="pr-3">必修/選択</th><th class="pr-3">年次</th><th class="pr-3">曜日</th><th class="pr-3">時限</th><th>開講区分</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% offerings.each do |offering| %>
                <tr>
                  <td class="py-2 pr-3"><%= offering.course.course_number %></td>
                  <td class="pr-3"><%= offering.course.name %></td>
                  <td class="pr-3"><%= offering.course.credits %></td>
                  <td class="pr-3"><%= offering.requirement_type %></td>
                  <td class="pr-3"><%= offering.grade_years.join('・') %></td>
                  <td class="pr-3"><%= offering.weekday %></td>
                  <td class="pr-3"><%= offering.periods.join('・') %></td>
                  <td><%= offering.term_type %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <div class="mt-6"><%= render 'shared/pagination', paginator: @paginator, path: ->(page) { course_registrations_path(page: page) } %></div>
    <% end %>
  </section>
</div>
