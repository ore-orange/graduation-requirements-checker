<%# 区分の科目を便覧から選んで予定に追加するフォーム。学期の画面の追加の枠と、一覧の小窓で使う %>
<!-- この行の区分の科目だけ。打った文字で一覧を絞り込む -->
<%= form_with url: plan_courses_path, class: 'space-y-2', data: { controller: 'course-filter' } do |f| %>
  <%= hidden_field_tag :term, term, id: nil, data: { term_field: true } %>
  <%= hidden_field_tag :view, 'all', id: nil if overview %>
  <%# 便覧のパネルを開いているときは、追加のあとも開いたままにする %>
  <% @catalogue_pane_params.each do |name, value| %>
    <%= hidden_field_tag name, value, id: nil %>
  <% end %>
  <input type="search" <%= 'autofocus' if overview %> placeholder="科目名・科目番号で絞り込み" autocomplete="off"
         aria-label="<%= row[:name] %>の科目を絞り込み"
         data-course-filter-target="query" data-action="input->course-filter#filter"
         class="w-full border border-slate-200 rounded-md px-2 py-1.5 text-xs text-slate-800 focus:outline-none focus:border-indigo-500">
  <select name="course_key" size="6" required aria-label="<%= row[:name] %>の科目を選択"
          data-course-filter-target="select"
          class="w-full border border-slate-200 rounded-md px-1 py-1 text-xs text-slate-800 focus:outline-none focus:border-indigo-500">
    <% selectable_in_row.each_with_index do |c, index| %>
      <option value="<%= c.fetch('key') %>" data-search="<%= [c['number'], c.fetch('name')].compact.join(' ') %>"<% if index.zero? %> selected<% end %>>
        <%= [c['number'], c.fetch('name'), "(#{credit_label(c['credits'])})"].compact.join(' ') %>
      </option>
    <% end %>
  </select>
  <p class="text-[11px] text-slate-500" data-course-filter-target="empty" hidden>見つかりません</p>
  <div class="flex justify-end">
    <%= f.submit '予定に追加', data: { course_filter_target: 'submit' },
                              class: 'px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed cursor-pointer' %>
  </div>
<% end %>
