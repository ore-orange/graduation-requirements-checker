<%# 区分の行から、表示中の学期に予定を追加する（便覧から選択）。開くボタンはカードの並び（plans/show）にある %>
<% box_id = row[:id] %>
<div class="mt-2 first:mt-0" data-add-course="<%= box_id %>">
  <% if selectable_in_row.any? %>
    <div id="add-box-<%= box_id %>" class="hidden p-2.5 rounded-xl border border-indigo-200 bg-white shadow-xs space-y-2 max-w-md">
      <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
        <span class="text-[10px] font-bold text-slate-600">便覧から選択</span>
        <button type="button" onclick="toggleRowAddBox('<%= box_id %>')" class="text-slate-400 hover:text-slate-600 text-xs cursor-pointer" aria-label="追加を閉じる">✕</button>
      </div>

      <%= render 'plans/add_course_form', row: row, selectable_in_row: selectable_in_row, term: term_param(@term), overview: false %>
    </div>
  <% elsif catalogue_in_row.empty? %>
    <p class="py-2 text-[11px] text-slate-400" data-no-selectable-course="no_catalogue">この区分は便覧に科目がないため、追加できません</p>
  <% else %>
    <p class="py-2 text-[11px] text-slate-400" data-no-selectable-course="all_taken">この区分の科目はすべて修得済み・履修中・追加済みです</p>
  <% end %>
</div>
