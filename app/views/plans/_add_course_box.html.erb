<%# 区分の行から、表示中の学期に予定を追加する（便覧から選択） %>
<%
  box_id = row[:id]
  catalogue_in_row = @curriculum.fetch('courses').select do |c|
    row[:categories].include?(c['category']) && c['selectable'] == true
  end
  selectable_in_row = catalogue_in_row.select { |c| @unavailable_keys.exclude?(c['key']) }
%>
<div class="mt-2" data-add-course="<%= box_id %>">
  <% if selectable_in_row.any? %>
    <button type="button" onclick="toggleRowAddBox('<%= box_id %>')"
            id="add-trigger-<%= box_id %>"
            class="w-full py-1.5 px-2 border border-dashed border-slate-300 rounded-lg text-slate-500 hover:text-indigo-600 hover:border-indigo-300 hover:bg-white text-xs font-medium transition cursor-pointer">
      ＋ <%= term_label(@term) %>に追加
    </button>

    <div id="add-box-<%= box_id %>" class="hidden p-2.5 rounded-xl border border-indigo-200 bg-white shadow-xs space-y-2 max-w-md">
      <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
        <span class="text-[10px] font-bold text-slate-600">便覧から選択</span>
        <button type="button" onclick="toggleRowAddBox('<%= box_id %>')" class="text-slate-400 hover:text-slate-600 text-xs cursor-pointer" aria-label="追加を閉じる">✕</button>
      </div>

      <!-- この行の区分の科目だけ -->
      <%= form_with url: plan_courses_path, class: 'space-y-2' do |f| %>
        <%= hidden_field_tag :term, term_param(@term), id: nil %>
        <select name="course_key" aria-label="<%= row[:name] %>の科目を選択"
                class="w-full border border-slate-200 rounded-md px-2 py-1.5 text-xs text-slate-800 focus:outline-none focus:border-indigo-500">
          <% selectable_in_row.each do |c| %>
            <option value="<%= c.fetch('key') %>">
              <%= [c['number'], c.fetch('name'), "(#{credit_label(c['credits'])})"].compact.join(' ') %>
            </option>
          <% end %>
        </select>
        <div class="flex justify-end">
          <%= f.submit '予定に追加', class: 'px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer' %>
        </div>
      <% end %>
    </div>
  <% elsif catalogue_in_row.empty? %>
    <p class="py-1.5 px-2 text-[11px] text-slate-400" data-no-selectable-course="no_catalogue">この区分は便覧に科目がないため、追加できません</p>
  <% else %>
    <p class="py-1.5 px-2 text-[11px] text-slate-400" data-no-selectable-course="all_taken">この区分の科目はすべて修得済み・履修中・追加済みです</p>
  <% end %>
</div>
