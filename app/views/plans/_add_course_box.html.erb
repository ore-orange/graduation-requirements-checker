<%# 区分の行から、表示中の学期に予定を追加する（便覧から選択 / 自由入力） %>
<%
  box_id = row[:id]
  selectable_in_row = @curriculum.fetch('courses').select do |c|
    row[:categories].include?(c['category']) && c['selectable'] == true && @unavailable_keys.exclude?(c['key'])
  end
%>
<div class="mt-2" data-add-course="<%= box_id %>">
  <button type="button" onclick="toggleRowAddBox('<%= box_id %>')"
          id="add-trigger-<%= box_id %>"
          class="w-full py-1.5 px-2 border border-dashed border-slate-300 rounded-lg text-slate-500 hover:text-indigo-600 hover:border-indigo-300 hover:bg-white text-xs font-medium transition cursor-pointer">
    ＋ <%= term_label(@term) %>に追加
  </button>

  <div id="add-box-<%= box_id %>" class="hidden p-2.5 rounded-xl border border-indigo-200 bg-white shadow-xs space-y-2 max-w-md">
    <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
      <div class="flex gap-1">
        <button type="button" onclick="switchRowAddMode('<%= box_id %>', 'catalogue')"
                id="mode-btn-cat-<%= box_id %>"
                class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white cursor-pointer">
          便覧から選択
        </button>
        <button type="button" onclick="switchRowAddMode('<%= box_id %>', 'custom')"
                id="mode-btn-cus-<%= box_id %>"
                class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer">
          自由入力
        </button>
      </div>
      <button type="button" onclick="toggleRowAddBox('<%= box_id %>')" class="text-slate-400 hover:text-slate-600 text-xs cursor-pointer" aria-label="追加を閉じる">✕</button>
    </div>

    <!-- モードA: 便覧から選択（この行の区分の科目だけ） -->
    <div id="add-mode-cat-<%= box_id %>">
      <% if selectable_in_row.any? %>
        <%= form_with url: plan_courses_path, class: 'space-y-2' do |f| %>
          <%= hidden_field_tag :term, term_param(@term), id: nil %>
          <select name="course_key" aria-label="<%= row[:name] %>の科目を選択"
                  class="w-full border border-slate-200 rounded-md px-2 py-1.5 text-xs text-slate-800 focus:outline-none focus:border-indigo-500">
            <% selectable_in_row.each do |c| %>
              <option value="<%= c.fetch('key') %>">
                <%= [c['number'], c.fetch('name'), "(#{credit_label(c['credits'])})"].compact.join(' ') %>
              </option>
            <% end %>
          </select>
          <div class="flex justify-end">
            <%= f.submit '予定に追加', class: 'px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer' %>
          </div>
        <% end %>
      <% else %>
        <p class="text-[11px] text-slate-500 py-1">この区分の便覧掲載科目はすべて修得・追加済みか、自由入力対象（他学部等）です。「自由入力」タブから追加できます。</p>
      <% end %>
    </div>

    <!-- モードB: 自由入力で追加。区分が複数ある行では区分を選ぶ -->
    <div id="add-mode-cus-<%= box_id %>" class="hidden">
      <%= form_with url: plan_courses_path, scope: :custom_course, class: 'space-y-1.5' do |f| %>
        <%= hidden_field_tag :term, term_param(@term), id: nil %>
        <% if row[:categories].size > 1 %>
          <%= f.select :category, row[:categories].map { |category| [category_label(category), category] }, {},
                       id: nil, aria: { label: '区分' },
                       class: 'w-full border border-slate-200 rounded-md px-2 py-1 text-xs focus:outline-none focus:border-indigo-500' %>
        <% else %>
          <%= f.hidden_field :category, value: row[:categories].first, id: nil %>
        <% end %>
        <div class="flex gap-1.5">
          <%= f.text_field :course_number, placeholder: '科目番号 (任意)', id: nil,
                           class: 'w-2/3 border border-slate-200 rounded-md px-2 py-1 text-xs focus:outline-none focus:border-indigo-500' %>
          <%= f.number_field :credits, value: 2, min: 0.5, step: 0.5, placeholder: '単位', required: true, id: nil,
                             class: 'w-1/3 border border-slate-200 rounded-md px-2 py-1 text-xs text-right focus:outline-none focus:border-indigo-500' %>
        </div>
        <%= f.text_field :name, placeholder: '授業科目名を入力...', required: true, id: nil,
                         class: 'w-full border border-slate-200 rounded-md px-2 py-1 text-xs focus:outline-none focus:border-indigo-500' %>
        <p class="text-[10px] text-amber-700 leading-tight">※便覧外の科目は「要確認」として計画に保存されます</p>
        <div class="flex justify-end pt-0.5">
          <%= f.submit '自由入力で追加', class: 'px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
