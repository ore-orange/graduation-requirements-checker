<%
  cat_course = @courses_by_key[plan.course.curriculum_key]
  course_num = cat_course&.dig('number') || plan.course.course_number
  is_custom = custom_course?(plan.course.curriculum_key)
%>
<div data-plan="<%= plan.id %>" data-course-key="<%= plan.course.curriculum_key %>"
     class="p-2 rounded-lg border <%= is_custom ? 'border-amber-300 bg-amber-50/70' : 'border-sky-200 bg-sky-50/70' %> shadow-2xs">
  <div class="flex items-center justify-between gap-1 text-[10px] font-mono <%= is_custom ? 'text-amber-800' : 'text-sky-700' %>">
    <span>
      <%= course_num.presence || (is_custom ? '自由入力' : '履修予定') %>
      <% if is_custom %>
        <span class="font-sans font-bold text-amber-800">(要確認)</span>
      <% else %>
        <span class="font-sans">(予定)</span>
      <% end %>
    </span>
    <span class="font-sans font-bold <%= is_custom ? 'bg-amber-100 text-amber-900' : 'bg-sky-100 text-sky-800' %> px-1.5 py-0.5 rounded shrink-0">
      <%= credit_label(plan_credits(plan, @courses_by_key)) %>
    </span>
  </div>
  <div class="mt-0.5 flex items-start justify-between gap-1.5">
    <div class="font-semibold text-slate-800 leading-snug"><%= plan.course.name %></div>
    <div class="planner-edit-ui shrink-0">
      <%= button_to '削除', plan_course_path(plan), method: :delete,
                    class: 'px-1.5 py-0.5 rounded text-[10px] font-semibold bg-white border border-slate-200 text-slate-500 hover:text-rose-600 hover:border-rose-200 cursor-pointer',
                    form: { class: 'inline' },
                    aria: { label: "#{plan.course.name}を今後の履修予定から削除" } %>
    </div>
  </div>
</div>
