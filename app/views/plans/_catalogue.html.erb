<%# 便覧カタログ (#catalogue)。科目名・科目番号・区分で検索し、表示中の学期（@term）の予定として追加する %>
<section id="catalogue" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6" aria-labelledby="catalogue-heading">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 id="catalogue-heading" class="text-base font-bold text-slate-900">便覧カタログから科目を検索して追加</h2>
      <p class="text-xs text-slate-500 mt-0.5">科目名・科目番号・区分で2024年度便覧の掲載科目を横断検索し、履修予定へ追加できます。</p>
      <p class="text-xs mt-1 <%= @term_open ? 'text-indigo-700' : 'text-slate-500' %>" data-catalogue-term>
        <% if @term_open %>
          <span class="font-semibold"><%= term_label(@term) %></span> の予定として追加します。
        <% else %>
          <%= term_label(@term) %> は過去の学期のため追加できません。今の学期以降を表示すると追加できます。
        <% end %>
      </p>
    </div>
    <span class="text-xs font-semibold text-slate-500"><%= @catalogue.size %> 科目を表示中</span>
  </div>

  <%= form_with url: plan_path, method: :get, class: 'mt-4 grid items-end gap-3 sm:grid-cols-[1fr_1fr_auto_auto]' do |form| %>
    <%= hidden_field_tag :term, term_param(@term), id: nil %>
    <div>
      <%= form.label :q, '科目名・科目番号で検索', class: 'block text-xs font-semibold text-slate-600 mb-1' %>
      <%= form.search_field :q, value: @query, placeholder: '例: 機械学習 / 知能326 / 英語',
                            class: 'w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500' %>
    </div>
    <div>
      <%= form.label :category, '科目区分で絞り込み', class: 'block text-xs font-semibold text-slate-600 mb-1' %>
      <%= form.select :category,
                      @curriculum.fetch('courses').map { |course| course.fetch('category') }.uniq.map { |category| [category_label(category), category] },
                      { include_blank: 'すべての区分', selected: @category },
                      class: 'w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500' %>
    </div>
    <%= form.submit '検索する', class: 'px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer h-9.5' %>
    <%= link_to 'リセット', plan_path(term: term_param(@term)), class: 'px-3 py-2 rounded-xl text-xs font-semibold border border-slate-200 text-slate-600 hover:bg-slate-50 text-center h-9.5 flex items-center justify-center' %>
  <% end %>

  <% if @catalogue.empty? %>
    <p class="mt-4 rounded-xl bg-slate-50 p-4 text-xs text-slate-600">条件に一致する科目が見つかりませんでした。検索語や区分を変更してください。</p>
  <% else %>
    <ul class="mt-4 divide-y divide-slate-100 max-h-96 overflow-y-auto pr-1">
      <% @catalogue.each do |course| %>
        <% unavailable = catalogue_availability(course, unavailable_keys: @unavailable_keys, persisted_keys: @persisted_keys) %>
        <li class="py-3" data-catalogue-key="<%= course.fetch('key') %>">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <% if course['number'].present? %>
                  <span class="font-mono text-xs text-slate-400"><%= course['number'] %></span>
                <% end %>
                <h3 class="text-sm font-semibold text-slate-900"><%= course.fetch('name') %></h3>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700"><%= category_label(course.fetch('category')) %></span>
                <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-[11px] font-bold text-indigo-700"><%= credit_label(course['credits']) %></span>
                <% if course['required'] %>
                  <span class="rounded-md bg-rose-50 px-2 py-0.5 text-[11px] font-bold text-rose-700">専門必修</span>
                <% end %>
              </div>
              <% if course['requires_approval'] %>
                <p class="mt-1 text-xs text-amber-800">※指導教員の履修承認確認が必要です</p>
              <% end %>
              <% if course['review_reason'].present? %>
                <p class="mt-1 text-xs text-amber-800">※要確認: <%= course['review_reason'] %></p>
              <% end %>
            </div>
            <% if unavailable %>
              <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-500"><%= unavailable %></span>
            <% elsif @term_open %>
              <%= form_with url: plan_courses_path, class: 'shrink-0' do |form| %>
                <%= form.hidden_field :course_key, value: course.fetch('key'), id: nil %>
                <%= hidden_field_tag :term, term_param(@term), id: nil %>
                <%= form.submit "#{term_label(@term)}に追加", class: 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer',
                                                            aria: { label: "#{course.fetch('name')}を#{term_label(@term)}の予定に追加" } %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
