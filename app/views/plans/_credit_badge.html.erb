<%# 区分の単位バッジ。単位は全学期の累計。status が nil なら色を付けない（区分ごとの必要単位がない場合） %>
<%
  row_id = local_assigns[:row_id]
  # 緑＝足りる、黄＝足りない。塗り＝いまの時点で決まっている、点線の枠＝まだ決まっていない。
  color = case status
          when :satisfied then 'border-emerald-200 bg-emerald-50 text-emerald-800' # 修得だけで足りている
          when :projected then 'border-dashed border-emerald-300 bg-white text-emerald-700' # 履修中・予定を入れれば足りる
          when :needs_review then 'border-dashed border-amber-300 bg-white text-amber-800' # 不足と言い切れない
          when nil then 'border-transparent bg-slate-100 text-slate-600'
          else 'border-amber-300 bg-amber-100 text-amber-900' # 予定を入れても足りない
          end
%>
<div class="mt-1.5 inline-flex flex-wrap items-center gap-x-1 px-2 py-0.5 rounded-full border text-[11px] font-semibold <%= color %>">
  <span>修得 <%= credit_number(credits[:earned]) %></span>
  <% if credits[:planned].positive? %>
    <span>・ 予定 <%= credit_number(credits[:planned]) %></span>
  <% end %>
  <% if req %>
    <span>／ 必要 <span<% if row_id %> data-sync-row-req="<%= row_id %>"<% end %>><%= req %></span></span>
  <% end %>
</div>
