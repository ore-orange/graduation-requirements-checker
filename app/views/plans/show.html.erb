<% content_for :title, app_name %>
<% content_for :full_bleed, true %>
<%# 表は縦に長いので、追加・削除で同じ画面（同じ URL）に戻るときはスクロール位置を保つ。戻る先は PlanCoursesController#back_to_plan が決める %>
<% turbo_refreshes_with(method: :replace, scroll: :preserve) %>

<div class="min-h-screen bg-slate-50 text-slate-800 font-sans pb-16">
  <%= render 'shared/nav' %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-6">
    <%# スクロール位置を保つので、結果は画面に固定して見えるようにする %>
    <%= render 'shared/toast' %>

    <h2 class="sr-only">履修計画表</h2>

    <%
      mapped_categories = StudentWorkspaceHelper::PLANNER_GROUPS.flat_map { |g| g[:rows].flat_map { |r| r[:categories] } }
      credits_of_term = @terms.index_with { |term| term_credits(@enrollments_by_term.fetch(term, []), @plans_by_term.fetch(term, []), @courses_by_key) }
      overall_credit = term_credits(@enrollments, @plans, @courses_by_key)
      button_class = 'h-14 px-3.5 flex flex-col items-center justify-center gap-0.5 rounded-xl border text-sm whitespace-nowrap transition'
      selected_class = 'bg-indigo-600 border-indigo-600 text-white font-semibold'
      unselected_class = 'bg-white border-slate-200 text-slate-600 hover:border-indigo-200 hover:bg-indigo-50/60 hover:text-indigo-700'
    %>

    <% unless @overview %>
      <!-- 便覧カタログ（右側のパネル）を開け閉めするボタン。開いているかどうかは URL の pane で持つ -->
      <div class="flex justify-end">
        <% pane_button_class = 'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border text-xs font-semibold transition' %>
        <% if @catalogue_open %>
          <%= link_to plan_path(term: term_param(@term)),
                      class: "#{pane_button_class} bg-indigo-600 border-indigo-600 text-white hover:bg-indigo-700",
                      aria: { expanded: true, controls: 'catalogue' }, data: { catalogue_toggle: 'close' } do %>
            <span aria-hidden="true">✕</span> 便覧を閉じる
          <% end %>
        <% else %>
          <%= link_to plan_path(term: term_param(@term), pane: 'catalogue'),
                      class: "#{pane_button_class} bg-white border-indigo-200 text-indigo-700 hover:bg-indigo-50",
                      aria: { expanded: false }, data: { catalogue_toggle: 'open' } do %>
            便覧から探す
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- 学期の切り替え（せまい画面ではボタンの列だけ横にスクロール） -->
    <nav class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-3" aria-label="学期の切り替え">
      <ol class="flex gap-1.5 overflow-x-auto">
        <!-- 全学期の一覧。2行目は全学期の単位の合計 -->
        <li class="flex-1 min-w-max">
          <%= link_to plan_path(view: 'all'),
                      class: "#{button_class} #{@overview ? selected_class : unselected_class}",
                      aria: { current: (@overview ? 'page' : nil) }, data: { term_button: 'all' } do %>
            <span>一覧</span>
            <span class="text-[11px] font-normal <%= @overview ? 'text-indigo-100' : 'text-slate-400' %>">合計 <%= credit_number(overall_credit[:total]) %>単位</span>
          <% end %>
        </li>
        <li class="w-px shrink-0 my-2 bg-slate-200" aria-hidden="true"></li>
        <% @terms.each do |term| %>
          <% selected = !@overview && term == @term %>
          <li class="flex-1 min-w-max">
            <%# 便覧のパネルを開いているときは、学期を切り替えても開いたままにする %>
            <%= link_to plan_path(term: term_param(term), pane: ('catalogue' if @catalogue_open)),
                        class: "#{button_class} #{selected ? selected_class : unselected_class}",
                        aria: { current: (selected ? 'page' : nil) },
                        data: { term_button: term_param(term), term_current: (term == @current_term ? true : nil) } do %>
              <span><%= term_label(term) %></span>
              <span class="text-[11px] font-normal <%= selected ? 'text-indigo-100' : 'text-slate-400' %>">
                <%= credit_number(credits_of_term.fetch(term)[:total]) %>単位<%= '・現在' if term == @current_term %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </nav>

    <% if @overview %>
      <%= render 'plans/overview', credits_of_term: credits_of_term, overall_credit: overall_credit, mapped_categories: mapped_categories %>
    <% else %>
      <%# 左に学期の表、右に便覧カタログのパネル（開いているときだけ）。せまい画面ではパネルは画面の右側に重なる %>
      <div class="flex flex-col xl:flex-row xl:items-start gap-6">
        <div class="min-w-0 flex-1">
          <%= render 'plans/term_table', term_credit: credits_of_term.fetch(@term), mapped_categories: mapped_categories %>
        </div>
        <%= render 'plans/catalogue' if @catalogue_open %>
      </div>
    <% end %>

    <% if @unplaced_enrollments.any? %>
      <!-- 学期が登録されていない履修履歴（どの学期にも表示できないため、ここにまとめる） -->
      <section class="bg-white rounded-2xl border border-amber-200 shadow-xs p-6" aria-labelledby="unplaced-heading">
        <h2 id="unplaced-heading" class="text-base font-bold text-slate-900">学期が登録されていない履修履歴</h2>
        <p class="text-xs text-slate-500 mt-0.5">履修した学期がわからないため、上の学期別の表には表示していません。卒業要件の判定には含めています。</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4 text-xs">
          <% @unplaced_enrollments.each do |enrollment| %>
            <%= render 'plans/enrollment_card', enrollment: enrollment %>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>
</div>

<script>
  function toggleRowAddBox(rowId) {
    const box = document.getElementById('add-box-' + rowId);
    const trigger = document.getElementById('add-trigger-' + rowId);
    if (!box || !trigger) return;

    const isHidden = box.classList.contains('hidden');
    if (isHidden) {
      box.classList.remove('hidden');
      trigger.classList.add('hidden');
    } else {
      box.classList.add('hidden');
      trigger.classList.remove('hidden');
    }
  }
</script>
