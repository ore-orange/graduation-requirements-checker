<% content_for :title, app_name %>
<% content_for :full_bleed, true %>

<div class="min-h-screen bg-slate-50 text-slate-800 font-sans pb-16">
  <%= render 'shared/nav' %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-6">
    <%= render 'shared/flash' %>

    <h2 class="sr-only">履修計画表</h2>

    <%
      mapped_categories = StudentWorkspaceHelper::PLANNER_GROUPS.flat_map { |g| g[:rows].flat_map { |r| r[:categories] } }
      unmapped_enrollments = @term_enrollments.reject { |e| mapped_categories.include?(course_category(e.course.curriculum_key, @courses_by_key)) }
      unmapped_term_plans = @term_plans.reject { |p| mapped_categories.include?(course_category(p.course.curriculum_key, @courses_by_key)) }
      unmapped_unscheduled_plans = @unscheduled_plans.reject { |p| mapped_categories.include?(course_category(p.course.curriculum_key, @courses_by_key)) }
      term_earned = @term_enrollments.select { |e| e.enrollment_status == 'completed' }.sum(BigDecimal('0')) { |e| e.credits_earned || BigDecimal('0') }
      term_current = @term_enrollments.select { |e| StudentWorkspace::CURRENT_STATUSES.include?(e.enrollment_status) }.sum(BigDecimal('0')) { |e| e.course.credits || BigDecimal('0') }
      term_planned = @term_plans.sum(BigDecimal('0')) { |p| plan_credits(p, @courses_by_key) }
      is_current_term = @term == @current_term
      nav_class = 'w-9 h-9 shrink-0 flex items-center justify-center rounded-xl border border-slate-200 text-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600'
    %>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden" data-term="<%= term_param(@term) %>">
      <!-- 学期の切り替え -->
      <div class="px-4 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
        <% if @prev_term %>
          <%= link_to '‹', plan_path(term: term_param(@prev_term)), class: nav_class,
                      aria: { label: "前の学期（#{term_label(@prev_term)}）" }, data: { term_nav: 'prev' } %>
        <% else %>
          <span class="w-9 shrink-0"></span>
        <% end %>

        <div class="text-center">
          <h2 class="text-base font-bold text-slate-900">
            <%= term_label(@term) %>（<%= @term_year %>年度）
            <% if is_current_term %>
              <span class="ml-1 align-middle text-[11px] font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-full">現在</span>
            <% end %>
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            修得 <%= credit_number(term_earned) %>単位
            <% if term_current.positive? %> ・ 履修中 <%= credit_number(term_current) %>単位<% end %>
            <% if term_planned.positive? %> ・ 予定 <%= credit_number(term_planned) %>単位<% end %>
          </p>
          <ol class="mt-2 flex items-center justify-center gap-1.5" aria-label="学期の一覧">
            <% @terms.each do |term| %>
              <li>
                <%= link_to plan_path(term: term_param(term)),
                            class: "block w-2.5 h-2.5 rounded-full #{term == @term ? 'bg-indigo-600' : (term == @current_term ? 'bg-indigo-200 hover:bg-indigo-300' : 'bg-slate-200 hover:bg-slate-300')}",
                            title: term_label(term), aria: { label: term_label(term), current: (term == @term ? 'page' : nil) } do %>
                <% end %>
              </li>
            <% end %>
          </ol>
        </div>

        <% if @next_term %>
          <%= link_to '›', plan_path(term: term_param(@next_term)), class: nav_class,
                      aria: { label: "次の学期（#{term_label(@next_term)}）" }, data: { term_nav: 'next' } %>
        <% else %>
          <span class="w-9 shrink-0"></span>
        <% end %>
      </div>

      <!-- 区分バッジの凡例 -->
      <p class="px-4 sm:px-6 py-2 border-b border-slate-100 text-[11px] text-slate-500" data-credit-legend>
        区分の単位は全学期の合計です。
        <span class="font-semibold text-slate-600">修得</span>＝修得済みの単位、
        <span class="font-semibold text-slate-600">予定</span>＝履修中と履修予定の単位、
        <span class="font-semibold text-slate-600">必要</span>＝卒業に必要な単位。
      </p>

      <!-- 区分 × この学期の科目 -->
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left table-fixed min-w-[640px]">
          <thead>
            <tr class="bg-slate-50/90 border-b border-slate-200 text-xs font-bold text-slate-600">
              <th class="w-64 py-3.5 px-4 border-r border-slate-200">卒業要件区分</th>
              <th class="py-3.5 px-3">この学期の科目</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-xs">
            <% StudentWorkspaceHelper::PLANNER_GROUPS.each do |group| %>
              <% group_check = find_check(@assessment.projected, group[:check_id]) %>
              <!-- 親グループ見出し行 -->
              <tr class="bg-slate-100/80 border-y border-slate-200" data-planner-group="<%= group[:id] %>">
                <td colspan="2" class="py-2 px-4">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-bold text-slate-800 text-xs uppercase tracking-wider" data-sync-group-title="<%= group[:id] %>"><%= group[:title] %></span>
                    <span class="text-[11px] font-semibold text-slate-600">
                      領域要件: <strong data-sync-group-req="<%= group[:id] %>"><%= group[:req] %></strong>単位以上
                      <% if group_check %>
                        （見込み算入: <%= credit_label(group_check.counted_credits) %> / <%= assessment_status_label(group_check.status) %>）
                      <% end %>
                    </span>
                  </div>
                </td>
              </tr>

              <% group[:rows].each do |row| %>
                <%
                  cell_enrollments = @term_enrollments.select { |e| row[:categories].include?(course_category(e.course.curriculum_key, @courses_by_key)) }
                  cell_plans = @term_plans.select { |p| row[:categories].include?(course_category(p.course.curriculum_key, @courses_by_key)) }
                  row_plans = @plans.select { |p| row[:categories].include?(course_category(p.course.curriculum_key, @courses_by_key)) }
                  row_credits = category_credits(@enrollments, @plans, row[:categories], @courses_by_key)
                  row_has_custom = row_plans.any? { |p| custom_course?(p.course.curriculum_key) }
                  row_status = row_check_status(@assessment, row[:check_ids], has_custom_plan: row_has_custom)
                  subtotal = planner_subtotal_for(row[:id])
                %>
                <% if subtotal && subtotal[:row_ids].first == row[:id] %>
                  <%
                    subtotal_categories = group[:rows].select { |r| subtotal[:row_ids].include?(r[:id]) }.flat_map { |r| r[:categories] }
                    subtotal_plans = @plans.select { |p| subtotal_categories.include?(course_category(p.course.curriculum_key, @courses_by_key)) }
                    subtotal_status = row_check_status(@assessment, subtotal[:check_ids],
                                                       has_custom_plan: subtotal_plans.any? { |p| custom_course?(p.course.curriculum_key) })
                  %>
                  <!-- 合計で数える区分のまとまり（必要単位はここにだけ出す） -->
                  <tr class="align-top bg-indigo-50/30" data-planner-subtotal="<%= subtotal[:id] %>">
                    <th class="p-3.5 border-r border-slate-200">
                      <div class="font-bold text-slate-800 text-sm leading-snug"><%= subtotal[:name] %></div>
                      <%= render 'plans/credit_badge', credits: category_credits(@enrollments, @plans, subtotal_categories, @courses_by_key),
                                                       req: subtotal[:req], status: subtotal_status %>
                    </th>
                    <td class="p-3.5 text-[11px] text-slate-500 leading-relaxed">
                      下の<%= subtotal[:row_ids].size %>区分の単位を合計して判定します。区分ごとの必要単位はありません。
                    </td>
                  </tr>
                <% end %>
                <tr class="align-top hover:bg-slate-50/40" data-planner-row="<%= row[:id] %>">
                  <!-- 区分名セル（単位は全学期の累計） -->
                  <th class="p-3.5 border-r border-slate-200 bg-slate-50/30 <%= 'pl-8' if subtotal %>">
                    <div class="font-bold text-slate-800 text-sm leading-snug" data-sync-row-title="<%= row[:id] %>"><%= row[:name] %></div>
                    <% if subtotal %>
                      <%= render 'plans/credit_badge', credits: row_credits, req: nil, status: nil %>
                    <% else %>
                      <%= render 'plans/credit_badge', credits: row_credits, req: row[:req], status: row_status, row_id: row[:id] %>
                    <% end %>
                    <p class="mt-1.5 text-[11px] text-slate-400 font-normal leading-relaxed"><%= row[:subtitle] %></p>
                  </th>

                  <!-- この学期の科目 -->
                  <td class="p-2.5">
                    <% if cell_enrollments.empty? && cell_plans.empty? %>
                      <div class="text-slate-300 py-2">—</div>
                    <% else %>
                      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                        <% cell_enrollments.each do |enrollment| %>
                          <%= render 'plans/enrollment_card', enrollment: enrollment %>
                        <% end %>
                        <% cell_plans.each do |plan| %>
                          <%= render 'plans/plan_card', plan: plan %>
                        <% end %>
                      </div>
                    <% end %>
                    <% if @term_open %>
                      <%= render 'plans/add_course_box', row: row %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>

            <% if unmapped_enrollments.any? || unmapped_term_plans.any? %>
              <tr class="bg-slate-100/80 border-y border-slate-200">
                <td colspan="2" class="py-2 px-4 font-bold text-slate-700 text-xs">その他・卒業算入対象外</td>
              </tr>
              <tr class="align-top">
                <th class="p-3.5 border-r border-slate-200 bg-slate-50/30">
                  <div class="font-bold text-slate-700 text-sm">算入対象外・未分類</div>
                  <p class="mt-1 text-[11px] text-slate-400 font-normal">情報科学演習など卒業単位に含めない科目</p>
                </th>
                <td class="p-2.5">
                  <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                    <% unmapped_enrollments.each do |enrollment| %>
                      <%= render 'plans/enrollment_card', enrollment: enrollment %>
                    <% end %>
                    <% unmapped_term_plans.each do |plan| %>
                      <%= render 'plans/plan_card', plan: plan %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @unplaced_enrollments.any? %>
      <!-- 学期が登録されていない履修履歴（どの学期にも表示できないため、ここにまとめる） -->
      <section class="bg-white rounded-2xl border border-amber-200 shadow-xs p-6" aria-labelledby="unplaced-heading">
        <h2 id="unplaced-heading" class="text-base font-bold text-slate-900">学期が登録されていない履修履歴</h2>
        <p class="text-xs text-slate-500 mt-0.5">履修した学期がわからないため、上の学期別の表には表示していません。卒業要件の判定には含めています。</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4 text-xs">
          <% @unplaced_enrollments.each do |enrollment| %>
            <%= render 'plans/enrollment_card', enrollment: enrollment %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @unscheduled_plans.any? %>
      <!-- 学期未定の履修予定（学期を入れる前に追加された予定。新しい予定は学期の表から追加する） -->
      <section id="unscheduled" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6" aria-labelledby="unscheduled-heading">
        <h2 id="unscheduled-heading" class="text-base font-bold text-slate-900">学期未定の履修予定</h2>
        <p class="text-xs text-slate-500 mt-0.5">履修する学期が決まっていない予定です。卒業要件の判定には含めています。新しい予定は、上の表で学期を選んで追加してください。</p>
        <div class="mt-4 space-y-4 text-xs">
          <% StudentWorkspaceHelper::PLANNER_GROUPS.flat_map { |g| g[:rows] }.each do |row| %>
            <% row_plans = @unscheduled_plans.select { |p| row[:categories].include?(course_category(p.course.curriculum_key, @courses_by_key)) } %>
            <% next if row_plans.empty? %>
            <div data-unscheduled-row="<%= row[:id] %>">
              <h3 class="text-xs font-bold text-slate-700 mb-1.5"><%= row[:name] %></h3>
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                <% row_plans.each do |plan| %>
                  <%= render 'plans/plan_card', plan: plan %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if unmapped_unscheduled_plans.any? %>
            <div data-unscheduled-row="unmapped">
              <h3 class="text-xs font-bold text-slate-700 mb-1.5">その他・卒業算入対象外</h3>
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                <% unmapped_unscheduled_plans.each do |plan| %>
                  <%= render 'plans/plan_card', plan: plan %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- 全科目横断検索カタログ (#catalogue) -->
    <section id="catalogue" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6" aria-labelledby="catalogue-heading">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 id="catalogue-heading" class="text-base font-bold text-slate-900">便覧カタログから科目を検索して追加</h2>
          <p class="text-xs text-slate-500 mt-0.5">科目名・科目番号・区分で2024年度便覧の掲載科目を横断検索し、履修予定へ追加できます。</p>
          <p class="text-xs mt-1 <%= @term_open ? 'text-indigo-700' : 'text-slate-500' %>" data-catalogue-term>
            <% if @term_open %>
              <span class="font-semibold"><%= term_label(@term) %></span> の予定として追加します。
            <% else %>
              <%= term_label(@term) %> は過去の学期のため追加できません。今の学期以降を表示すると追加できます。
            <% end %>
          </p>
        </div>
        <span class="text-xs font-semibold text-slate-500"><%= @catalogue.size %> 科目を表示中</span>
      </div>

      <%= form_with url: plan_path, method: :get, class: 'mt-4 grid items-end gap-3 sm:grid-cols-[1fr_1fr_auto_auto]' do |form| %>
        <%= hidden_field_tag :term, term_param(@term), id: nil %>
        <div>
          <%= form.label :q, '科目名・科目番号で検索', class: 'block text-xs font-semibold text-slate-600 mb-1' %>
          <%= form.search_field :q, value: @query, placeholder: '例: 機械学習 / 知能326 / 英語',
                                class: 'w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500' %>
        </div>
        <div>
          <%= form.label :category, '科目区分で絞り込み', class: 'block text-xs font-semibold text-slate-600 mb-1' %>
          <%= form.select :category,
                          @curriculum.fetch('courses').map { |course| course.fetch('category') }.uniq.map { |category| [category_label(category), category] },
                          { include_blank: 'すべての区分', selected: @category },
                          class: 'w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500' %>
        </div>
        <%= form.submit '検索する', class: 'px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer h-9.5' %>
        <%= link_to 'リセット', plan_path(term: term_param(@term)), class: 'px-3 py-2 rounded-xl text-xs font-semibold border border-slate-200 text-slate-600 hover:bg-slate-50 text-center h-9.5 flex items-center justify-center' %>
      <% end %>

      <% if @catalogue.empty? %>
        <p class="mt-4 rounded-xl bg-slate-50 p-4 text-xs text-slate-600">条件に一致する科目が見つかりませんでした。検索語や区分を変更するか、上の表の各区分の「自由入力」で追加してください。</p>
      <% else %>
        <ul class="mt-4 divide-y divide-slate-100 max-h-96 overflow-y-auto pr-1">
          <% @catalogue.each do |course| %>
            <% unavailable = catalogue_availability(course, unavailable_keys: @unavailable_keys, persisted_keys: @persisted_keys) %>
            <li class="py-3" data-catalogue-key="<%= course.fetch('key') %>">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <% if course['number'].present? %>
                      <span class="font-mono text-xs text-slate-400"><%= course['number'] %></span>
                    <% end %>
                    <h3 class="text-sm font-semibold text-slate-900"><%= course.fetch('name') %></h3>
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700"><%= category_label(course.fetch('category')) %></span>
                    <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-[11px] font-bold text-indigo-700"><%= credit_label(course['credits']) %></span>
                    <% if course['required'] %>
                      <span class="rounded-md bg-rose-50 px-2 py-0.5 text-[11px] font-bold text-rose-700">専門必修</span>
                    <% end %>
                  </div>
                  <% if course['requires_approval'] %>
                    <p class="mt-1 text-xs text-amber-800">※指導教員の履修承認確認が必要です</p>
                  <% end %>
                  <% if course['review_reason'].present? %>
                    <p class="mt-1 text-xs text-amber-800">※要確認: <%= course['review_reason'] %></p>
                  <% end %>
                </div>
                <% if unavailable %>
                  <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-500"><%= unavailable %></span>
                <% elsif @term_open %>
                  <%= form_with url: plan_courses_path, class: 'shrink-0' do |form| %>
                    <%= form.hidden_field :course_key, value: course.fetch('key'), id: nil %>
                    <%= hidden_field_tag :term, term_param(@term), id: nil %>
                    <%= form.submit "#{term_label(@term)}に追加", class: 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer',
                                                                aria: { label: "#{course.fetch('name')}を#{term_label(@term)}の予定に追加" } %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </main>
</div>

<script>
  function toggleRowAddBox(rowId) {
    const box = document.getElementById('add-box-' + rowId);
    const trigger = document.getElementById('add-trigger-' + rowId);
    if (!box || !trigger) return;

    const isHidden = box.classList.contains('hidden');
    if (isHidden) {
      box.classList.remove('hidden');
      trigger.classList.add('hidden');
    } else {
      box.classList.add('hidden');
      trigger.classList.remove('hidden');
    }
  }

  function switchRowAddMode(rowId, mode) {
    const catBox = document.getElementById('add-mode-cat-' + rowId);
    const cusBox = document.getElementById('add-mode-cus-' + rowId);
    const catBtn = document.getElementById('mode-btn-cat-' + rowId);
    const cusBtn = document.getElementById('mode-btn-cus-' + rowId);
    if (!catBox || !cusBox) return;

    if (mode === 'custom') {
      catBox.classList.add('hidden');
      cusBox.classList.remove('hidden');
      cusBtn.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white cursor-pointer';
      catBtn.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer';
    } else {
      cusBox.classList.add('hidden');
      catBox.classList.remove('hidden');
      catBtn.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white cursor-pointer';
      cusBtn.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer';
    }
  }
</script>
