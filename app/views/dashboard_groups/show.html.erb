<%= turbo_frame_tag "dashboard-group-#{@definition[:id]}" do %>
  <% missing = find_check(@assessment.projected, @definition[:check_id])&.missing_courses.to_a %>
  <%# 狭い画面では積み、広い画面では表のように桁を揃える。横スクロールは作らない。 %>
  <% columns = 'sm:grid-cols-[minmax(0,1fr)_minmax(6rem,12rem)_auto_auto]' %>

  <div class="overflow-hidden rounded-xl border border-slate-200">
    <% if missing.any? %>
      <p class="bg-indigo-50/60 px-4 py-2.5 text-xs font-medium text-indigo-900">
        未修得・未計画の必修: <%= missing.join('、') %>
      </p>
    <% end %>

    <%# 列幅は一覧全体で1つ。行ごとにグリッドを作ると、桁数の違いでバーの左端がずれる。 %>
    <div class="bg-white sm:grid <%= columns %>">
      <p class="hidden gap-x-4 px-4 py-2 text-xs text-slate-500 sm:col-span-4 sm:grid sm:grid-cols-subgrid <%= 'border-t border-slate-200' if missing.any? %>">
        <span>項目</span>
        <span>修得状況</span>
        <span class="text-right">修得 / 必要単位</span>
        <span class="text-right">判定</span>
      </p>

      <ul class="sm:col-span-4 sm:grid sm:grid-cols-subgrid">
        <% @definition[:rows].each do |row| %>
          <% detail = @metrics.row(row) %>
          <%# 自分の必要単位を持たない行は、上位の枠への寄与でしかない。 %>
          <%# バーも判定も出さず、修得した単位だけ添える。 %>
          <% contribution = row[:req].nil? %>
          <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 border-t border-slate-100 px-4 py-3 sm:col-span-4 sm:grid-cols-subgrid sm:gap-y-0.5"
              data-check="<%= row[:id] %>" data-status="<%= contribution ? 'contribution' : detail[:status] %>">
            <p class="col-start-1 row-start-1 min-w-0 text-sm font-semibold text-slate-800 sm:col-start-1 sm:row-start-1">
              <%= row[:name] %>
            </p>
            <p class="col-start-1 row-start-2 min-w-0 text-xs text-slate-500 sm:col-start-1 sm:row-start-2">
              <%= row[:subtitle] %>
            </p>

            <% unless contribution %>
              <div class="col-start-1 row-start-3 min-w-0 sm:col-start-2 sm:row-span-2 sm:row-start-1 sm:self-center">
                <%= render 'dashboard/bar', summary: detail, size: 'h-2.5' %>
              </div>
            <% end %>

            <p class="col-start-2 row-start-3 justify-self-end text-sm tabular-nums sm:col-start-3 sm:row-span-2 sm:row-start-1 sm:self-center">
              <% if contribution %>
                <span class="font-semibold text-slate-700"><%= credit_number(detail[:earned]) %></span><%
                %><% if detail[:planned].positive? %><span class="font-semibold text-sky-600">+<%= credit_number(detail[:planned]) %></span><% end %><%
                %><span class="text-slate-500"> 単位</span>
              <% else %>
                <span class="font-bold text-slate-900"><%= credit_number(detail[:earned]) %></span><%
                %><% if detail[:planned].positive? %><span class="font-semibold text-sky-600">+<%= credit_number(detail[:planned]) %></span><% end %><%
                %><span class="text-slate-500"> / <%= detail[:req] %></span>
              <% end %>
            </p>

            <span class="col-start-2 row-start-1 flex flex-wrap justify-end gap-1.5 justify-self-end sm:col-start-4 sm:row-span-2 sm:row-start-1 sm:self-center">
              <% unless contribution %>
                <% status_badges(detail).each do |label, klass| %>
                  <span class="demo-status <%= klass %>"><%= label %></span>
                <% end %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
