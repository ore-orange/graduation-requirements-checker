<%= turbo_frame_tag "dashboard-group-#{@definition[:id]}" do %>
  <% missing = find_check(@assessment.projected, @definition[:check_id])&.missing_courses.to_a %>
  <% if missing.any? %>
    <p class="border-t border-slate-200 pt-3 text-xs font-medium text-red-700">
      未修得・未計画の必修: <%= missing.join('、') %>
    </p>
  <% end %>
  <ul class="space-y-3 <%= 'border-t border-slate-200' if missing.empty? %> pt-3">
    <% @definition[:rows].each do |row| %>
      <% detail = @metrics.row(row) %>
      <li data-check="<%= row[:id] %>" data-status="<%= detail[:status] %>">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <div class="min-w-0 sm:w-56">
            <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-800">
              <span><%= row[:name] %></span>
              <span class="demo-status <%= assessment_status_class(detail[:status]) %>">
                <%= assessment_status_label(detail[:status]) %>
              </span>
            </p>
            <p class="mt-0.5 text-xs text-slate-500"><%= row[:subtitle] %></p>
            <% if detail[:missing].any? %>
              <p class="mt-0.5 text-xs font-medium text-red-700">
                未修得・未計画: <%= detail[:missing].join('、') %>
              </p>
            <% end %>
          </div>
          <%= render 'dashboard/bar', summary: detail %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
