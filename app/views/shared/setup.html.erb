<% content_for :title, "初期設定が必要です | #{app_name}" %>
<%# データがまだ無く、どの画面へ移動してもここに戻るため、ナビゲーションは出さない %>
<% content_for :full_bleed, true %>
<div class="px-4 py-10 sm:px-6 lg:px-8">
  <section class="demo-panel mx-auto max-w-2xl" aria-labelledby="setup-heading" data-setup>
    <h1 id="setup-heading" class="text-2xl font-bold text-slate-900"><%= app_name %> — 初期設定が必要です</h1>
    <p class="mt-4 leading-7 text-slate-700"><%= @setup_message %></p>

    <% if Rails.env.local? %>
      <%# 開発環境でだけ出す。デモの公開設定とは関係なく、利用者にコマンドは見せない %>
      <p class="mt-4 text-sm leading-6 text-slate-600">デモの人工データを入れる場合は、アプリを実行している開発環境で次を実行してから再読み込みしてください。</p>
      <pre class="mt-3 overflow-x-auto rounded-lg bg-slate-900 p-4 text-sm text-white"><code>bin/rails db:prepare
bin/rails db:seed</code></pre>
      <p class="mt-3 text-sm leading-6 text-slate-600">Docker Compose を使用している場合は <code>docker compose exec web bin/rails db:seed</code> を実行してください。ページへのアクセスではデータを自動作成しません。</p>
    <% end %>

    <%# この画面はどの操作でも戻ってくるため、別のアカウントへ移れる出口を置く %>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to '再読み込み', root_path, class: 'demo-button' %>
      <%= button_to 'ログアウト', session_path, method: :delete, class: 'demo-button-secondary' %>
    </div>
  </section>
</div>
