<header class="bg-white border-b border-slate-200 sticky top-0 z-30">
  <div class="<%= content_width_class %> mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-0 sm:h-16 flex flex-wrap items-center justify-between gap-3">
    <%# 学生に依存しない見出しにしてある。講義登録のようにマスタだけを扱う画面でも同じものを出す。 %>
    <div class="flex items-center gap-2.5">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2 1 6l9 4 7-3.111V12h2V6l-9-4Zm-5 8.889V14c0 1.105 2.239 2 5 2s5-.895 5-2v-3.111l-5 2.222-5-2.222Z"/></svg>
      </span>
      <div>
        <h1 class="text-base font-bold leading-tight text-slate-900"><%= app_name %></h1>
        <p class="text-xs text-slate-500">卒業までの道のりを、ひと目で。</p>
      </div>
    </div>

    <nav class="flex overflow-x-auto max-w-full space-x-1 bg-slate-100 p-1 rounded-xl border border-slate-200/60" aria-label="画面の切り替え">
      <% [[root_path, '卒業ダッシュボード'],
          [requirements_path, '卒業要件の確認'],
          [plan_path, '履修計画表'],
          [course_registrations_path, '講義登録'],
          [profile_path, 'マイページ']].each do |path, label| %>
        <%# 取り込みの確認画面は「講義登録」の中にいる扱いにする %>
        <%# 便覧の下書きの確認画面は「卒業要件の確認」の中にいる扱いにする %>
        <% active = current_page?(path) ||
                    (path == course_registrations_path && request.path.start_with?('/timetable_uploads')) ||
                    (path == requirements_path && request.path.start_with?('/curricula')) %>
        <%= link_to label, path,
              aria: { current: ('page' if active) },
              class: ['whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm transition-all',
                      active ? 'bg-white text-indigo-600 shadow-xs font-semibold' : 'text-slate-600 hover:text-slate-900 font-medium'] %>
      <% end %>
    </nav>

    <%# 実在するデモ学生(DemoAccount.available_students)が2人以上いるときだけ、年度の切り替えを出す
        (開発・テスト環境限定の仮の仕組み)。STUDENTS の定義ではなく実在する学生で数えないと、便覧が
        未公開の年度の定義しか無くても切り替えが出てしまい、選んだ瞬間に全画面がロックアウトする。
        @student は StudentWorkspace を使わない画面(講義登録など)では nil なので、それに依存せず
        セッションの値だけで「今どちらか」を決める。 %>
    <% available_students = DemoAccount.available_students %>
    <% if available_students.size > 1 %>
      <div class="flex items-center gap-1 text-xs" aria-label="デモ学生の切り替え">
        <% current_year = session[:demo_admission_year] %>
        <% available_students.each do |definition| %>
          <% active = definition.admission_year == current_year ||
                      (current_year.blank? && definition == available_students.first) %>
          <%= button_to "#{definition.admission_year}年度", demo_switch_path(admission_year: definition.admission_year),
                method: :patch,
                class: ['px-2.5 py-1 rounded-lg border font-medium transition-colors',
                        active ? 'bg-indigo-50 border-indigo-200 text-indigo-700' :
                                 'bg-white border-slate-200 text-slate-500 hover:text-slate-800'] %>
        <% end %>
      </div>
    <% end %>
  </div>
</header>
