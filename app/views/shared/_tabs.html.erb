<nav aria-label="メインメニュー" class="border-b border-slate-200 bg-white">
  <ul class="mx-auto flex w-full max-w-7xl gap-1 px-4 sm:px-6 lg:px-8">
    <% [['ホーム', root_path], ['ローカルデモ', demo_path], ['授業登録', course_registrations_path]].each do |label, path| %>
      <% current = path == root_path ? current_page?(root_path) : request.path.start_with?(path) || (path == course_registrations_path && request.path.start_with?('/timetable_uploads')) %>
      <li>
        <%= link_to label, path, 'aria-current': (current ? 'page' : nil),
                    class: "inline-block border-b-2 px-4 py-3 text-sm font-semibold #{current ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
      </li>
    <% end %>
  </ul>
</nav>
