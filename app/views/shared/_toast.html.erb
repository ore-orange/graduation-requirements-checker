<%# notice / alert を画面上部に固定表示する。スクロールしていても見える %>
<% if flash[:notice] || flash[:alert] %>
  <div class="pointer-events-none fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4">
    <% if flash[:notice] %>
      <div role="status" data-controller="toast" data-toast-auto-dismiss-value="5000"
           class="pointer-events-auto flex w-full max-w-xl items-start gap-3 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-950 shadow-lg">
        <p class="flex-1"><%= flash[:notice] %></p>
        <button type="button" data-action="toast#close" aria-label="メッセージを閉じる" class="font-bold leading-none">×</button>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div role="alert" data-controller="toast"
           class="pointer-events-auto flex w-full max-w-xl items-start gap-3 rounded-xl border border-red-300 bg-red-50 p-4 text-red-950 shadow-lg">
        <p class="flex-1"><%= flash[:alert] %></p>
        <button type="button" data-action="toast#close" aria-label="メッセージを閉じる" class="font-bold leading-none">×</button>
      </div>
    <% end %>
  </div>
<% end %>
