<%# バーは量だけを表す。修得済みは緑、履修中は水色、残りは灰色。 %>
<%# 足りているかどうかは、判定バッジの色が受け持つ。 %>
<%# ホバーすると、不足（予定もすべて修得したとしても足りない分）・予定・履修済みの単位を出す。 %>
<%
  tooltip_lines = nil
  if summary[:req]
    shortage = [summary[:req] - summary[:earned] - summary[:planned], 0].max
    tooltip_lines = [['text-amber-400', '不足', shortage],
                     ['text-sky-400', '予定', summary[:planned]],
                     ['text-emerald-500', '履修済み', summary[:earned]]]
  end
%>
<%# バーは細いので、上下に余白を足してホバーしやすくする。 %>
<%# ツールチップはマウスに付いて動く（bar_tooltip_controller）。画面に見えている間しか中身が出ないので、 %>
<%# 読み上げには同じ内容をゲージ自体の名前として渡す。 %>
<div class="-my-1 py-1"
     <% if tooltip_lines %>
       role="img" aria-label="<%= tooltip_lines.map { |_, label, credits| "#{label} #{credit_number(credits)}単位" }.join('、') %>"
       data-controller="bar-tooltip"
       data-action="mouseenter->bar-tooltip#show mousemove->bar-tooltip#move mouseleave->bar-tooltip#hide"
     <% end %>>
  <div class="flex <%= local_assigns.fetch(:size, 'h-3') %> overflow-hidden rounded-full bg-slate-200">
    <div class="h-full bg-emerald-500" style="width: <%= summary[:earned_pct] %>%"></div>
    <% if summary[:planned_pct].positive? %>
      <div class="h-full bg-sky-400" style="width: <%= summary[:planned_pct] %>%"></div>
    <% end %>
  </div>
  <% if tooltip_lines %>
    <%# popover にして最前面のレイヤーに出す。位置はカーソルに合わせてJSが決める。 %>
    <div popover="manual" aria-hidden="true" data-bar-tooltip-target="tip"
         class="pointer-events-none fixed inset-auto m-0 space-y-0.5 whitespace-nowrap rounded-md border-0 bg-slate-900 px-2.5 py-1.5 text-xs font-semibold text-white shadow-md">
      <% tooltip_lines.each do |dot, label, credits| %>
        <span class="flex items-center gap-1.5">
          <span class="size-2 shrink-0 rounded-full bg-current <%= dot %>"></span>
          <span><%= label %>: <span class="tabular-nums"><%= credit_number(credits) %>単位</span></span>
        </span>
      <% end %>
    </div>
  <% end %>
</div>
