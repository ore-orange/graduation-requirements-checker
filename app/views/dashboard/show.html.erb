<% content_for :title, app_name %>
<% content_for :full_bleed, true %>
<%
  metrics = @metrics
  actual_credits = @assessment.actual.counted_credits
  custom_credits = metrics.custom_plans.sum(BigDecimal('0')) { |plan| plan_credits(plan, @courses_by_key) }
  planned_delta = (@assessment.projected.counted_credits - actual_credits) + custom_credits
  groups = StudentWorkspaceHelper::PLANNER_GROUPS.map { |definition| [definition, metrics.group(definition)] }
  unmet_groups = groups.reject { |_, summary| summary[:status] == :satisfied }
%>

<div class="min-h-screen bg-slate-50 pb-16 font-sans text-slate-800">
  <%= render 'shared/nav' %>

  <main class="mx-auto max-w-5xl space-y-6 px-4 pt-6 sm:px-6 lg:px-8">
    <%= render 'shared/flash' %>

    <h2 class="sr-only">進捗ダッシュボード</h2>

    <section aria-labelledby="progress-heading" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <h3 id="progress-heading" class="sr-only">卒業に向けた単位の充足状況</h3>

      <%# 上段: 卒業算入単位の合計と、充足していない大項目 %>
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 px-5 py-5 sm:px-6">
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1"
           data-assessment="total"
           data-status="<%= @assessment.projected.status %>"
           data-actual-status="<%= @assessment.actual.status %>"
           data-counted-credits="<%= credit_number(actual_credits) %>"
           data-projected-credits="<%= credit_number(actual_credits + planned_delta) %>">
          <span class="text-4xl font-extrabold tracking-tight text-slate-900 tabular-nums"><%= credit_number(actual_credits) %></span>
          <% if planned_delta.positive? %>
            <span class="text-2xl font-bold text-sky-700 tabular-nums">+<%= credit_number(planned_delta) %></span>
          <% end %>
          <span class="text-base font-medium text-slate-500">/ 130 単位</span>
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <% if unmet_groups.empty? %>
            <span class="demo-status status-satisfied">卒業要件を満たしています</span>
          <% else %>
            <% unmet_groups.each do |definition, summary| %>
              <span class="demo-status <%= assessment_status_class(summary[:status]) %>">
                <%= group_short_title(definition) %> <%= assessment_status_label(summary[:status]) %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# 下段: 大項目ごとの充足状況。小項目はここには出さない %>
      <ul class="divide-y divide-slate-200">
        <% groups.each do |definition, summary| %>
          <li class="px-5 py-4 sm:px-6"
              data-check="<%= definition[:check_id] %>"
              data-status="<%= summary[:status] %>"
              data-actual-status="<%= find_check(@assessment.actual, definition[:check_id])&.status %>"
              data-projected-status="<%= find_check(@assessment.projected, definition[:check_id])&.status %>">
            <%# 開いたときだけ小項目を取りに行く。閉じている間は読み込まない。 %>
            <details class="group/detail">
              <summary class="flex cursor-pointer list-none flex-col gap-2 rounded-lg sm:flex-row sm:items-center sm:gap-4">
                <span class="flex shrink-0 items-center gap-1.5 text-sm font-bold text-slate-900 sm:w-44">
                  <svg class="size-4 shrink-0 text-slate-400 transition-transform group-open/detail:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M7.5 5.5 12 10l-4.5 4.5V5.5Z" />
                  </svg>
                  <%= group_short_title(definition) %>
                </span>
                <%= render 'dashboard/bar', summary: summary %>
              </summary>
              <div class="mt-3 sm:pl-5">
                <%= turbo_frame_tag "dashboard-group-#{definition[:id]}",
                                    src: dashboard_group_path(definition[:id]), loading: 'lazy' do %>
                  <p class="border-t border-slate-200 pt-3 text-xs text-slate-500">読み込んでいます…</p>
                <% end %>
              </div>
            </details>
          </li>
        <% end %>
      </ul>
    </section>

    <p class="px-1 text-xs text-slate-500">
      濃いバーが修得済みの算入単位、水色が履修中・履修計画による見込みです。
    </p>
  </main>
</div>
