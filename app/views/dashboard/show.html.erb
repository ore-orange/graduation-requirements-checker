<% content_for :title, app_name %>
<% content_for :full_bleed, true %>
<%
  metrics = @metrics
  actual_credits = @assessment.actual.counted_credits
  custom_credits = metrics.custom_plans.sum(BigDecimal('0')) { |plan| plan_credits(plan, @courses_by_key) }
  planned_delta = (@assessment.projected.counted_credits - actual_credits) + custom_credits
  total = metrics.total(actual_credits, planned_delta)
  groups = StudentWorkspaceHelper::PLANNER_GROUPS.map { |definition| [definition, metrics.group(definition)] }
%>

<div class="min-h-screen bg-slate-100 pb-16 font-sans text-slate-800">
  <%= render 'shared/nav' %>

  <main class="mx-auto max-w-5xl space-y-6 px-4 pt-8 sm:px-6 lg:px-8">
    <%= render 'shared/flash' %>

    <%# 画面名はヘッダーのタブで分かるので、見出しは読み上げ用だけ残す %>
    <h2 class="sr-only">卒業ダッシュボード</h2>

    <%# 卒業に必要な単位の合計 %>
    <section aria-labelledby="total-heading"
             class="grid gap-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:grid-cols-[minmax(0,15rem)_1fr] sm:p-6"
             data-assessment="total"
             data-status="<%= @assessment.projected.status %>"
             data-actual-status="<%= @assessment.actual.status %>"
             data-counted-credits="<%= credit_number(actual_credits) %>"
             data-projected-credits="<%= credit_number(actual_credits + planned_delta) %>">
      <div>
        <h3 id="total-heading" class="text-xs font-semibold text-slate-500">卒業に必要な単位</h3>
        <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5"
           title="修得済み <%= credit_number(actual_credits) %> 単位<% if planned_delta.positive? %> ＋ 履修中 <%= credit_number(planned_delta) %> 単位（計 <%= credit_number(actual_credits + planned_delta) %> 単位）<% end %>">
          <span class="text-4xl font-extrabold tracking-tight text-slate-900 tabular-nums"><%= credit_number(actual_credits) %></span>
          <% if planned_delta.positive? %>
            <span class="text-2xl font-bold text-sky-600 tabular-nums">+<%= credit_number(planned_delta) %></span>
          <% end %>
          <span class="text-sm font-medium text-slate-500">/ 130 単位</span>
        </p>
      </div>

      <div class="min-w-0 space-y-2 sm:border-l sm:border-slate-100 sm:pl-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-1.5">
            <% status_badges(total).each do |label, klass| %>
              <span class="demo-status <%= klass %>"><%= label %></span>
            <% end %>
          </div>
          <p class="text-xs text-slate-500 tabular-nums">
            修得済み <%= credit_number(actual_credits) %> 単位
            <% if planned_delta.positive? %>／ 履修中 <%= credit_number(planned_delta) %> 単位<% end %>
          </p>
        </div>
        <%= render 'dashboard/bar', summary: total, size: 'h-4' %>
        <p class="text-xs text-slate-500">区分別の要件もあわせて確認してください。</p>
      </div>
    </section>

    <%# 区分別の卒業要件 %>
    <section aria-labelledby="groups-heading" class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 id="groups-heading" class="text-base font-bold text-slate-900">区分別の卒業要件</h3>
          <p class="text-xs text-slate-500">カードをクリックすると、内訳を確認できます。</p>
        </div>
        <%# バーの読み方。足りているかどうかはバッジが出すので、ここは量の凡例だけ。 %>
        <ul class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <% [['bg-emerald-500', '修得済み'], ['bg-sky-400', '履修中'], ['bg-slate-200', '未修得']].each do |color, label| %>
            <li class="flex items-center gap-1.5"><span class="size-2 rounded-full <%= color %>" aria-hidden="true"></span><%= label %></li>
          <% end %>
        </ul>
      </div>

      <% groups.each do |definition, summary| %>
        <details class="group/card rounded-2xl border border-slate-200 bg-white shadow-xs transition hover:border-indigo-300 hover:shadow-md open:border-indigo-400 open:shadow-md open:ring-1 open:ring-indigo-300"
                 data-check="<%= definition[:check_id] %>"
                 data-status="<%= summary[:status] %>"
                 data-actual-status="<%= find_check(@assessment.actual, definition[:check_id])&.status %>"
                 data-projected-status="<%= find_check(@assessment.projected, definition[:check_id])&.status %>">
          <%# 並びは上の合計カードに揃える。左に区分名と単位数、右にステータスとバー。 %>
          <summary class="grid cursor-pointer list-none gap-4 p-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-5 sm:p-6"
                   aria-label="<%= group_short_title(definition) %>の内訳を開閉する">
            <div>
              <h4 class="flex items-center gap-1.5 text-xs font-semibold text-slate-500">
                <svg class="size-3.5 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="<%= group_icon_path(definition) %>" />
                </svg>
                <%= group_short_title(definition) %>
              </h4>
              <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5"
                 title="修得済み <%= credit_number(summary[:earned]) %> 単位<% if summary[:planned].positive? %> ＋ 履修中 <%= credit_number(summary[:planned]) %> 単位（計 <%= credit_number(summary[:earned] + summary[:planned]) %> 単位）<% end %>">
                <span class="text-3xl font-extrabold tracking-tight text-slate-900 tabular-nums"><%= credit_number(summary[:earned]) %></span>
                <% if summary[:planned].positive? %>
                  <span class="text-xl font-bold text-sky-600 tabular-nums">+<%= credit_number(summary[:planned]) %></span>
                <% end %>
                <span class="text-sm font-medium text-slate-500">/ <%= summary[:req] %> 単位</span>
              </p>
            </div>

            <div class="min-w-0 space-y-2 sm:border-l sm:border-slate-100 sm:pl-6">
              <div class="flex items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-1.5">
                  <% status_badges(summary).each do |label, klass| %>
                    <span class="demo-status <%= klass %>"><%= label %></span>
                  <% end %>
                </div>
                <div class="flex items-center gap-3">
                  <p class="hidden text-xs text-slate-500 tabular-nums sm:block">
                    修得済み <%= credit_number(summary[:earned]) %> 単位
                    <% if summary[:planned].positive? %>／ 履修中 <%= credit_number(summary[:planned]) %> 単位<% end %>
                  </p>
                  <%# 開閉できることは、この丸ボタンと矢印の向きで示す %>
                  <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition group-hover/card:bg-indigo-100 group-hover/card:text-indigo-600 group-open/card:bg-indigo-100 group-open/card:text-indigo-600">
                    <svg class="size-4 transition-transform group-open/card:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M5.5 7.5 10 12l4.5-4.5H5.5Z" />
                    </svg>
                  </span>
                </div>
              </div>
              <%= render 'dashboard/bar', summary: summary, size: 'h-3' %>
            </div>
          </summary>

          <%# 開いたときだけ内訳を取りに行く。閉じている間は読み込まない。 %>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6">
            <%= turbo_frame_tag "dashboard-group-#{definition[:id]}",
                                src: dashboard_group_path(definition[:id]), loading: 'lazy' do %>
              <p class="rounded-xl bg-slate-50 px-4 py-3 text-xs text-slate-500">読み込んでいます…</p>
            <% end %>
          </div>
        </details>
      <% end %>
    </section>

    <p class="flex items-start gap-1.5 px-1 text-xs text-slate-500">
      <svg class="mt-0.5 size-3.5 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 12H9V9h2v5Zm0-6H9V6h2v2Z" />
      </svg>
      青い「+」は履修中の単位です。修得済みの単位と区別して表示しています。
    </p>
  </main>
</div>
