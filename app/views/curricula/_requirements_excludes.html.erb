<%# 算入しない科目(設計書 項目6・9)。要件ではなく除外なので、章・行のツリーには混ぜず、専用の枠に出す。 %>
<%# ここに当たる科目は、修得していても卒業の単位に数えません。取り違えると、学生の単位が消えます。 %>
<%#
  画面から書ける条件は2つ。書いた条件を**すべて**満たす科目だけを外す。
    区分 ＋ 提供コース(一致 / 以外) … 便覧は提供コースの名前を持たないので、科目番号の接頭辞で表す
    科目番号(いくつでも)            … 名指しの科目
  条件が全部空の除外は、すべての科目を外してしまうので保存しない(RequirementsEdit#check_adjustment)。
%>
<% excludes = review.exclude_rules %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_excludes">
  <h4 class="text-sm font-bold text-slate-900">算入しない科目</h4>
  <p class="mt-0.5 text-xs text-slate-500">
    ここに当たる科目は、修得しても卒業の単位に数えません。書いた条件は、すべて満たしたものだけが当たります。
    科目表に無く、どの区分の科目番号のパターンにも当たらない科目は、ここに書かなくても「要確認」になります。
  </p>
  <% if excludes.empty? %>
    <p class="mt-2 text-sm text-slate-600">ありません。</p>
  <% else %>
    <ul class="mt-3 space-y-2">
      <% excludes.each do |rule| %>
        <li><%= render 'requirements_rule', review: review, rule: rule %></li>
      <% end %>
    </ul>
  <% end %>

  <%# 算入しない科目を足す。型は exclude に決まっているので、人は条件と理由だけを書く。 %>
  <div id="new_exclude" class="mt-3 rounded-lg border border-dashed border-slate-300 px-3 py-2">
    <p class="text-xs font-semibold text-slate-700">＋ 算入しない科目を足す</p>
    <%= render 'requirements_problems', review: review, kind: 'new_exclude', id: 'new' %>
    <div class="mt-2 grid gap-3 sm:grid-cols-2">
      <% CurriculumImport::RequirementsEdit::EXCLUDE_FIELDS.each do |field, kind| %>
        <div class="<%= 'sm:col-span-2' if %i[text optional_list].include?(kind) %>">
          <%= rule_field_input "new_exclude[#{field}]", field, kind, { 'type' => 'exclude' }, review %>
        </div>
      <% end %>
    </div>
  </div>
</div>
