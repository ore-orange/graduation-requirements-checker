<%# 持ち主(行・章・枠・総単位の枠)と同じことを言っている決まり(設計書 項目1)。箱は描かない。 %>
<%#
  箱を消しても、人が見る値は1つも減らない。必要単位と対象の区分は、すぐ上の持ち主の欄にそのまま出ている。
  ただし label と detail は学生のカードに出る値(Rules::Base#label / #detail)で、持ち主の欄には無い。
  箱と一緒に消すと直す手段が画面から無くなるので、持ち主の「…」の中に移す(設計書 項目2-2)。
  欄の名前は箱に出すときと同じ(rules[添字][...])なので、保存側は何も変わらない。
%>
<% key = rule_param_key(rule, review) %>
<%= hidden_field_tag "#{key}[id]", rule['id'], id: nil %>
<label class="block sm:col-span-2"><span class="font-semibold text-slate-700">学生の画面に出す名前</span>
  <%= rv_text "#{key}[label]", rule['label'], id: nil,
              class: "mt-1 block w-full #{RequirementsReviewHelper::FIELD_CLASS}" %></label>
<label class="block sm:col-span-2"><span class="font-semibold text-slate-700">学生の画面に出す説明</span>
  <%= rv_text "#{key}[detail]", rule['detail'], id: nil,
              class: "mt-1 block w-full #{RequirementsReviewHelper::FIELD_CLASS}" %></label>
