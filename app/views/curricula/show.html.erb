<% content_for :title, "便覧の下書き | #{app_name}" %>
<% content_for :full_bleed, true %>

<div class="min-h-screen bg-slate-100 pb-16 font-sans text-slate-800">
  <%= render 'shared/nav' %>

  <main class="mx-auto max-w-5xl space-y-6 px-4 pt-8 sm:px-6 lg:px-8">
    <%= render 'shared/flash' %>

    <h2 class="sr-only">便覧の下書きの確認</h2>

    <section aria-labelledby="draft-heading" class="rounded-2xl border border-amber-200 bg-white p-5 shadow-xs sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold text-amber-800">下書き（学生の卒業判定には使われません）</p>
          <h3 id="draft-heading" class="mt-1 text-lg font-bold text-slate-900">
            <%= @curriculum.admission_year %>年度入学 <%= @curriculum.faculty_name %> <%= @curriculum.department_name %>
          </h3>
          <p class="mt-1 text-xs text-slate-500">
            識別名 <%= @curriculum.slug %> / <%= @curriculum.source_filename %>
          </p>
        </div>
        <%= button_to '下書きを削除', curriculum_path(@curriculum), method: :delete,
                      form: { data: { turbo_confirm: 'この下書きを削除します。元に戻せません。' } },
                      class: 'rounded-lg border border-rose-300 px-3 py-1.5 text-sm font-semibold text-rose-700 hover:bg-rose-50' %>
      </div>
      <% if @curriculum.import_error.present? %>
        <p role="alert" class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-900">
          <%= @curriculum.import_error %>
        </p>
      <% end %>
    </section>

    <%= render 'pages', curriculum: @curriculum %>
  </main>
</div>
