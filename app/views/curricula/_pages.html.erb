<%# どのページを読むかは、便覧ごとに人が決める。初めはすべて「読まない」にしてあり、推測では決めない。 %>
<%# 読み取りは1ページずつ、画面から順に呼ぶ(要件表を先に)。バックグラウンドの仕組みは使わない。 %>
<% reader_available = CurriculumReader.available? %>
<section aria-labelledby="pages-heading" class="rounded-2xl border border-slate-200 bg-white shadow-xs"
         data-controller="read-pages">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div class="min-w-0">
      <h3 id="pages-heading" class="text-base font-bold text-slate-900">読むページ</h3>
      <p class="mt-0.5 text-xs text-slate-500">
        ページごとに、科目表・要件表・読まない のどれかを選んでください。便覧によってページの並びが違うため、最初はすべて「読まない」です。
      </p>
      <% unless reader_available %>
        <p class="mt-1 text-xs text-slate-600">
          読み取りに使うAPIキー(CURRICULUM_READER_API_KEY)が設定されていないので、自動で読む機能は使えません。
        </p>
      <% end %>
    </div>
    <% if reader_available && curriculum.pages.any? { |page| Curriculum::READABLE_PAGE_KINDS.include?(page['kind']) } %>
      <button type="button" class="demo-button" data-read-pages-target="all" data-action="click->read-pages#readAll">全部読む</button>
    <% end %>
  </div>
  <p class="px-5 pt-3 text-xs font-medium text-slate-700 sm:px-6" role="status" aria-live="polite"
     data-read-pages-target="message"></p>

  <% if curriculum.pages.empty? %>
    <%# ページ数を数えられなかった下書きは、ページ数を手で指定して始める %>
    <%= form_with url: curriculum_path(curriculum), method: :patch, class: 'space-y-3 p-5 sm:p-6', data: { turbo: false } do |form| %>
      <p class="text-sm text-slate-700">この下書きにはページがありません。PDFのページ数を指定してください。</p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block">
          <span class="text-sm font-semibold text-slate-700">ページ数</span>
          <%= form.number_field :page_count, required: true, min: 1, max: Curriculum::MAX_PAGES,
                                class: 'mt-1 w-28 rounded border border-slate-300 bg-white px-2 py-1.5' %>
        </label>
        <%= form.submit 'ページを作る', class: 'demo-button' %>
      </div>
    <% end %>
  <% else %>
    <%= form_with url: curriculum_path(curriculum), method: :patch, class: 'p-5 sm:p-6', data: { turbo: false } do |form| %>
      <ul class="divide-y divide-slate-100">
        <% curriculum.pages.each do |page| %>
          <%= render 'page_row', curriculum: curriculum, page: page, reader_available: reader_available %>
        <% end %>
      </ul>
      <div class="mt-4 flex justify-end">
        <%= form.submit 'ページの指定を保存', class: 'demo-button' %>
      </div>
    <% end %>
  <% end %>
</section>
