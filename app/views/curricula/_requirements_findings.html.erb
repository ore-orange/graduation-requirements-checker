<%# 機械の突き合わせ(CurriculumImport::Validation)の結果。人が気づきにくい食い違いを、上にまとめて出す。 %>
<div id="requirements_findings" class="border-b border-slate-100 px-5 py-4 sm:px-6">
  <% if review.findings.empty? %>
    <p class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">
      突き合わせで見つかった問題はありません。機械でできる検査だけです。PDFと見比べる確認の代わりにはなりません。
    </p>
  <% else %>
    <% if review.blocking? %>
      <p role="alert" class="rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-900">
        公開を止める問題が<%= review.blocking_findings.size %>件あります。直すまで、この下書きは公開できません。
      </p>
    <% else %>
      <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">
        公開は止まりませんが、確かめてほしい点が<%= review.warning_findings.size %>件あります。
      </p>
    <% end %>
    <ul class="mt-3 space-y-2">
      <% review.findings.sort_by { |finding| finding[:blocking] ? 0 : 1 }.each do |finding| %>
        <li class="rounded-lg border px-3 py-2 text-sm <%= finding[:blocking] ? 'border-rose-200 bg-rose-50 text-rose-900' : 'border-amber-200 bg-amber-50 text-amber-900' %>"
            data-blocking="<%= finding[:blocking] %>" data-scope="<%= finding[:scope] %>">
          <span class="mr-2 inline-block rounded px-1.5 py-0.5 text-xs font-bold <%= finding[:blocking] ? 'bg-rose-700 text-white' : 'bg-amber-700 text-white' %>">
            <%= finding[:blocking] ? '公開を止める' : '確認' %>
          </span>
          <span class="text-xs font-semibold"><%= review.scope_name(finding[:scope]) %>: <%= finding[:target] %></span>
          <p class="mt-1"><%= finding[:reason] %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
