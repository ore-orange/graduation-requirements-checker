<%# 注釈のカード。表に収まらない便覧の但し書きを、判定に落とせるものも、落とせないものも、1つずつ人の目に出す。 %>
<%# 赤いカードは、判定に反映できていない(または、できない)もの。見たうえでどう扱うかを選ぶ。 %>
<div id="annotation_cards" class="border-t border-slate-100 px-5 py-5 sm:px-6">
  <h4 class="text-sm font-bold text-slate-900">注釈</h4>
  <p class="mt-0.5 text-xs text-slate-500">
    便覧の但し書きのうち、機械が拾えたものです。拾えていないものもあります。PDFの要件表の注も、見て確かめてください。
  </p>

  <% if review.cards.empty? %>
    <p class="mt-3 text-sm text-slate-600">拾えた注釈はありません。</p>
  <% else %>
    <ul class="mt-3 space-y-3">
      <% review.cards.each do |card| %>
        <% decision = card.decision %>
        <li id="annotation-<%= card.id %>" class="needs-attention rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-950"
            data-kind="<%= card.kind %>">
          <p class="text-xs font-bold text-rose-800">
            <%= card.kind == :foreign_student ? '外国人学生の特例(判定の対象外)' : '指導教員の承認が要る注釈' %>
            <% if card.page.present? %><span class="ml-2 font-normal">(<%= card.page.is_a?(Integer) ? "PDF#{card.page}ページ" : card.page %>)</span><% end %>
          </p>
          <p class="mt-1 font-medium">「<%= card.text %>」</p>
          <p class="mt-1 text-xs">
            <% if card.kind == :approval_applied %>
              この注記が当たる科目(<%= card.covers %>科目)は、履修登録に指導教員の承認が要ります。承認を得たかどうかは学生ごとに違い、
              PDFには書かれていません。学生が「承認あり」と答えるまで、その科目の単位は算入されず、判定は「要確認」になります。
            <% elsif card.kind == :approval_unattached %>
              対象の区分が分からず、科目に反映できていません。このままでは、承認が要る科目の単位が、承認なしで数えられます
              (判定が甘い側に倒れます)。区分を選んで承認の注記にするか、見たうえで反映しないと決めてください。
            <% else %>
              外国人学生の特例は、このアプリの判定の対象外です。判定には反映されません。特例の対象の学生には、
              画面の判定が当てはまらないことがあります。
            <% end %>
          </p>

          <% if card.decidable? %>
            <% if decision.present? && decision['disposition'] != CurriculumImport::Annotations::IGNORE %>
              <p class="mt-2 text-xs font-semibold text-emerald-900">
                <% if decision['disposition'] == CurriculumImport::Annotations::APPROVAL %>
                  区分「<%= review.category_label(decision['category']) %>」の承認の注記にしました。その区分の科目に承認の関門が付いています。
                <% else %>
                  規則「<a href="#rule-<%= decision['rule_id'] %>" class="underline"><%= decision['rule_id'] %></a>」(<%= rule_type_name(decision['disposition']) %>)を足しました。
                  必要な値は、規則の表で入れてください。入れるまで、突き合わせが公開を止めるか、警告を出します。
                <% end %>
              </p>
            <% else %>
              <% if decision.present? %>
                <p class="mt-2 text-xs font-semibold text-slate-800">判定に反映しないと決めて、記録しました。変えるときは、もう一度選んでください。</p>
              <% end %>
              <%= form_with url: update_rules_curriculum_path(review.curriculum), method: :patch, class: 'mt-2 flex flex-wrap items-end gap-2',
                            data: { turbo: false } do %>
                <%= hidden_field_tag :revision, review.revision, id: nil %>
                <label class="block">
                  <span class="text-xs font-semibold text-slate-800">どう扱うか</span>
                  <% options = [['判定に反映しない(記録だけする)', CurriculumImport::Annotations::IGNORE]] %>
                  <% options << ['承認の注記にする(右で区分を選ぶ)', CurriculumImport::Annotations::APPROVAL] if card.approval? %>
                  <%= select_tag "annotations[#{card.id}][disposition]", options_for_select(options + annotation_type_options),
                                 include_blank: '選んでください', id: nil, class: "mt-1 block #{RequirementsReviewHelper::FIELD_CLASS}" %>
                </label>
                <% if card.approval? %>
                  <label class="block">
                    <span class="text-xs font-semibold text-slate-800">承認が要る区分</span>
                    <%= select_tag "annotations[#{card.id}][category]",
                                   options_for_select(review.category_keys.map { |key| [review.category_label(key), key] }),
                                   include_blank: '(承認の注記にするときだけ)', id: nil, class: "mt-1 block #{RequirementsReviewHelper::FIELD_CLASS}" %>
                  </label>
                <% end %>
                <%= submit_tag '決める', class: 'demo-button', data: { disable_with: false } %>
              <% end %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
