<%# どの章・枠・行にも結びついていない決まり(設計書 項目6)。 %>
<%#
  判定は、便覧の決まりだけで決まる。どこからも指されていない決まりを画面から消すと、その要件が見えなくなるので、
  上のツリー・「算入しない科目」の枠が引き受けなかった決まりを、必ずここに出す。
  「決まりを足す」も、この枠の中に残す(AI が読み落とした要件を、人が足す唯一の手段)。
  このテンプレートは、ツリーと除外の枠より後に描くこと(先に描くと、ツリーに出るべき決まりをここが取ってしまう)。
%>
<% orphans = review.unclaimed_rules %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_rules">
  <h4 class="text-sm font-bold text-slate-900">どの行にも結びついていない決まり</h4>
  <p class="mt-0.5 text-xs text-slate-500">
    上の表のどの章・枠・行からも確かめられていない決まりです。判定には効きますが、学生の画面のどの行にも出ません。
    便覧にそう書かれているなら、そのままで構いません。行に出すべきものは、「結びつける先」で選んでください。
  </p>

  <% if orphans.empty? %>
    <p class="mt-2 text-sm text-slate-600">ありません(すべての決まりが、上の表のどこかに出ています)。</p>
  <% else %>
    <ul class="mt-3 space-y-2">
      <% orphans.each do |rule| %>
        <li>
          <%= render 'requirements_rule', review: review, rule: rule %>
          <%# 行に出すべき決まりは、ここから結びつける。人は id を打たない(設計書 項目5) %>
          <label class="mt-1 ml-3 block text-xs">
            <span class="font-semibold text-slate-700">この決まりを結びつける先</span>
            <%= rv_select "rules[#{review.rules.index { |item| item['id'] == rule['id'] }}][link]",
                          review.link_targets, nil, include_blank: '結びつけない', id: nil,
                          class: "mt-1 block #{field_class}" %>
          </label>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%# 決まりを足す。種類を選び、その種類が持つ欄に書く(JSON も id も使わない)。 %>
  <%# 種類ごとの欄は全部出しておき、選ばれていない種類の欄は type_fields が隠して送らないようにする。 %>
  <div id="new_rule" data-controller="type-fields" class="mt-3 rounded-lg border border-dashed border-slate-300 px-3 py-2">
    <p class="text-xs font-semibold text-slate-700">＋ 決まりを足す(AI が読み落とした要件)</p>
    <%= render 'requirements_problems', review: review, kind: 'new_rule', id: 'new' %>
    <div class="mt-2 flex flex-wrap items-end gap-3">
      <label class="block"><span class="text-xs font-semibold text-slate-700">種類</span>
        <%= rv_select 'new_rule[type]', CurriculumImport::Annotations::RULE_TYPES.map { |type| [rule_type_name(type), type] },
                      nil, include_blank: '選んでください', id: nil,
                      data: { type_fields_target: 'select', action: 'change->type-fields#sync' },
                      class: "mt-1 block #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">名前</span>
        <%= rv_text 'new_rule[label]', nil, id: nil, class: "mt-1 block w-56 #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">結びつける先</span>
        <%= rv_select 'new_rule[link]', review.link_targets, nil, include_blank: '結びつけない', id: nil,
                      class: "mt-1 block #{field_class}" %></label>
    </div>

    <% CurriculumImport::Annotations::RULE_TYPES.each do |type| %>
      <% skeleton = { 'type' => type } %>
      <% fields = CurriculumImport::RequirementsEdit.rule_fields(skeleton)
                    .except('label', 'detail', *CurriculumImport::RequirementsEdit::NESTED_RULE_FIELDS.keys)
                    .reject { |_, kind| kind == :paths } %>
      <div data-type-fields-target="block" data-type="<%= type %>" class="mt-2">
        <div class="grid gap-3 sm:grid-cols-2">
          <% fields.each do |field, kind| %>
            <div class="<%= 'sm:col-span-2' if %i[set text].include?(kind) %>">
              <%= rule_field_input "new_rule[fields][#{type}][#{field}]", field, kind, {}, review %>
            </div>
          <% end %>
        </div>
        <% if rule_logic_label(skeleton) %>
          <p class="text-xs text-slate-600">
            経路・条件は、足したあとに、この決まりの枠の中で書きます(先に種類を選んで保存してください)。
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
