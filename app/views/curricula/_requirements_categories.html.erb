<%# 区分の一覧。「総単位に数えない」区分は、その科目の単位が卒業の総単位に入らない。取り違えると単位が水増しされるので、目立たせる。 %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_categories">
  <h4 class="text-sm font-bold text-slate-900">区分</h4>
  <p class="mt-0.5 text-xs text-slate-500">科目表の科目は、この区分のどれかに割り当てられます。区分の名前と、卒業の総単位に数えるかを確かめてください。</p>
  <% if review.categories.empty? %>
    <p class="mt-2 text-sm text-slate-600">区分がまだありません。</p>
  <% else %>
    <ul class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200">
      <% review.categories.each_with_index do |category, index| %>
        <% key = "categories[#{index}]" %>
        <li id="category-<%= category['key'] %>" class="px-3 py-2 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-semibold text-slate-900">
              <%= category['label'] %> <span class="text-xs font-normal text-slate-500">(<%= category['key'] %>)</span>
              <% if human_confirmed?(category) %><span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
            </p>
            <p class="text-xs text-slate-700">
              <% if Array(category['number_patterns']).any? %>
                科目番号 <span class="font-semibold text-slate-900"><%= Array(category['number_patterns']).join('・') %></span> /
              <% end %>
              科目 <%= review.course_count(category['key']) %>件 /
              <% if category['counts_toward_total'] == false %>
                <span class="font-bold text-rose-700">卒業の総単位に数えない</span>
              <% else %>
                総単位に数える
              <% end %>
            </p>
          </div>
          <%= render 'requirements_problems', review: review, kind: 'category', id: category['key'] %>
          <details class="mt-1" <%= 'open' if review.open?('category', category['key']) %>>
            <summary class="cursor-pointer text-xs font-semibold text-slate-700">この区分を直す</summary>
            <div class="mt-2 flex flex-wrap items-end gap-3">
              <%= hidden_field_tag "#{key}[key]", category['key'], id: nil %>
              <label class="block"><span class="text-xs font-semibold text-slate-700">名前</span>
                <%= rv_text "#{key}[label]", category['label'], id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
              <label class="block"><span class="text-xs font-semibold text-slate-700">科目番号のパターン(カンマで区切る。科目表に無い科目を、番号でこの区分に数えます)</span>
                <%= rv_text "#{key}[number_patterns]", Array(category['number_patterns']).join(', '), id: nil,
                            class: "mt-1 block w-64 #{field_class}" %></label>
              <label class="flex items-center gap-1.5 text-xs text-slate-800">
                <%= hidden_field_tag "#{key}[counts_toward_total]", '0', id: nil %>
                <%= rv_check "#{key}[counts_toward_total]", '1', category['counts_toward_total'] != false, id: nil %>
                卒業の総単位に数える
              </label>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
