<%# 1ページ分の行。読み取りの結果は、この行だけを Turbo Stream で差し替えて見せる。 %>
<% readable = Curriculum::READABLE_PAGE_KINDS.include?(page['kind']) %>
<% status = Curriculum::PAGE_STATUS_LABELS.fetch(page['status'], '未読') %>
<%# 読み直すと、人が直した規則・章・行がどうなるか。あれば、読む前に確認を出す(read-pages コントローラが見る)。 %>
<% reread_warning = readable ? CurriculumImport::RereadWarning.for(curriculum.document, page) : nil %>
<li id="<%= dom_id(curriculum, "page_#{page['page']}") %>" class="py-2.5" data-page-wizard-target="page" data-page="<%= page['page'] %>"
    data-kind="<%= page['kind'] %>" data-status="<%= page['status'] %>"
    <% if reread_warning %>data-reread-warning="<%= reread_warning %>"<% end %>
    <% if reader_available && readable %>data-read-url="<%= read_page_curriculum_path(curriculum, page: page['page']) %>"<% end %>>
  <%# data-show は、どの表示で見せるかの印(page-wizard コントローラが見る)。wizard=1枚表示、list=一覧、nojs=JavaScript が動かないとき。 %>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div class="flex min-w-0 flex-wrap items-start gap-3">
      <%# ページ番号だけでは、どのページが要件表か画面から分からない。1枚表示では大きく、一覧では小さく中身を見せる(設計書 項目7・§6)。 %>
      <%# 画像が無い下書き(読み取り前・公開で落としたあと)では、壊れた画像を並べず、取り出した文字の冒頭を出す。 %>
      <% if curriculum.page_image_path(page['page']) %>
        <% image_url = page_image_curriculum_path(curriculum, page: page['page']) %>
        <%= image_tag image_url, loading: 'lazy', width: 600, alt: "#{page['page']}ページ目の見た目", data: { show: 'wizard' },
                      class: 'block h-auto w-full max-w-[600px] rounded border border-slate-300 bg-white' %>
        <%= image_tag image_url, loading: 'lazy', width: 64, alt: "#{page['page']}ページ目の見た目", data: { show: 'list nojs' },
                      class: 'block w-16 shrink-0 rounded border border-slate-300 bg-white' %>
      <% else %>
        <% excerpt = page['text'].to_s.strip %>
        <div data-show="wizard" data-page-text class="w-full max-w-[600px] rounded border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
          <% if excerpt.empty? %>
            <p>このページは、PDFから文字を取り出せませんでした(ページの画像もありません)。</p>
          <% else %>
            <p class="mb-1 text-xs font-semibold text-slate-600">ページの画像がないので、PDFから取り出した文字の冒頭を出します。</p>
            <p class="whitespace-pre-wrap break-words"><%= excerpt.first(200) %><%= '…' if excerpt.length > 200 %></p>
          <% end %>
        </div>
      <% end %>
      <p class="text-sm font-semibold text-slate-800 tabular-nums"><%= page['page'] %>ページ</p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-1">
      <fieldset data-show="wizard nojs" class="flex flex-wrap gap-x-5 gap-y-1">
        <legend class="sr-only"><%= page['page'] %>ページの種別</legend>
        <span aria-hidden="true" data-show="wizard" class="w-full text-sm font-semibold text-slate-800">このページは</span>
        <% Curriculum::PAGE_KINDS.each_with_index do |kind, index| %>
          <label class="flex items-center gap-1.5 text-sm text-slate-800">
            <%= radio_button_tag "pages[#{page['page']}]", kind, page['kind'] == kind, data: { action: 'click->page-wizard#choose' } %>
            <%= Curriculum::PAGE_KIND_LABELS.fetch(kind) %>
            <kbd data-show="wizard" class="rounded border border-slate-300 px-1 text-xs text-slate-500"><%= index + 1 %></kbd>
          </label>
        <% end %>
      </fieldset>
      <%# 一覧では、いま指定している種別を文で出し、「直す」でそのページの1枚表示に戻る。 %>
      <div data-show="list" class="flex items-center gap-3">
        <span class="text-sm font-semibold text-slate-800" data-page-wizard-target="kindLabel"><%= Curriculum::PAGE_KIND_LABELS.fetch(page['kind'], '読まない') %></span>
        <button type="button" class="rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                data-action="click->page-wizard#edit" data-page-number="<%= page['page'] %>">直す</button>
      </div>
      <%# 読む種別でない行も同じ幅の欄を空けて、種別の選択肢が縦に揃うようにする %>
      <div class="flex items-center justify-end gap-2 sm:w-48">
        <% if readable %>
          <span class="text-xs font-semibold <%= page['status'] == 'failed' ? 'text-rose-700' : 'text-slate-600' %>"><%= status %></span>
          <% if reader_available %>
            <button type="button" class="rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                    data-read-pages-target="one" data-action="click->read-pages#saveAndRead">
              <%= page['status'] == 'read' ? '読み直す' : '読む' %>
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <% if page['status'] == 'failed' && page['error'].present? %>
    <p role="alert" class="mt-1.5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-900"><%= page['error'] %></p>
  <% end %>
  <% Array(page['warnings']).each do |warning| %>
    <p class="mt-1.5 rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-900"><%= warning %></p>
  <% end %>
</li>
