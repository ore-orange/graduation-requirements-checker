<%# 区分ごとの必要単位。章 →(枠)→ 行 のツリー。1行が画面の1行に収まること(設計書 項目2)。 %>
<%#
  判定の数字を決める値(必要単位・対象の区分・決まりの中身・出典)は畳まない。畳んだ中の誤読は、人が開かないと
  見つからない。畳むのは、PDFと突き合わせるときに目で追わない値だけ(各段の「…」)。
  欄の名前は今までと同じで、保存はこの画面ただ1つのフォーム(requirements_form)がまとめて送る。
  決まりは、この画面の中で1か所だけが欄を持つ(presenter の claim_rule_box?)。先に総単位の枠、次にツリー、
  そのあと「算入しない科目」「どの行にも結びついていない決まり」の枠が、残りを引き受ける。
%>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_table">
  <h4 class="text-sm font-bold text-slate-900">区分ごとの必要単位</h4>
  <p class="mt-0.5 text-xs text-slate-500">
    学生の画面に出る表と同じ並びです。PDFの要件表と、必要単位・科目名・対象科目・修了要件を1行ずつ見比べてください。
    並びは行の左の ▲▼ で変えられます。
  </p>

  <div id="total_credits_row" class="mt-3 rounded-xl border border-slate-200 bg-white px-4 py-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="text-sm font-bold text-slate-900">卒業に必要な総単位</span>
        <p class="mt-0.5 text-xs text-slate-600">この数字が低く読まれていると、足りない学生にも「卒業できます」と答えます。</p>
      </div>
      <label class="flex items-center gap-2">
        <span class="sr-only">必要な総単位</span>
        <%= rv_number 'display[total_credits]', review.display['total_credits'], id: nil,
                      class: "w-20 text-right font-bold #{field_class}" %>
        <span class="text-xs text-slate-500">単位以上</span>
      </label>
    </div>
    <%= render 'requirements_finding_notes', findings: review.findings_for(:display, 'total_credits') %>
    <%= render 'requirements_problems', review: review, kind: 'total', id: 'total' %>

    <%# 総単位に当たる決まりも、同じ枠に出す。数字だけを出して決まりを隠すと、判定を決める側が見えない(設計書 項目6) %>
    <% if (total_rule = review.total_rule) %>
      <div class="mt-2">
        <%= render 'requirements_rule', review: review, rule: total_rule %>
      </div>
    <% end %>
  </div>

  <div class="mt-3 space-y-3" data-controller="reorder">
    <% review.groups.each_with_index do |group, group_index| %>
      <%= render 'requirements_group', review: review, group: group, group_index: group_index %>
    <% end %>
  </div>

  <%= render 'requirements_subtotals', review: review %>
</div>
