<%# 区分ごとの必要単位。章(group)の枠の中に行(row)を入れ子にし、行が指す規則のうち入れ子を持つものを %>
<%# さらにその下に出す、卒業要件のツリー。直す欄は畳まない(畳んだ中の誤読は、人が開かないと見つからない)。 %>
<%# 欄の名前は今までと同じ。保存は、この画面ただ1つのフォーム(requirements_form)がまとめて送る。 %>
<% total = review.display['total_credits'] %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_table">
  <h4 class="text-sm font-bold text-slate-900">区分ごとの必要単位</h4>
  <p class="mt-0.5 text-xs text-slate-500">学生の画面に出る表と同じ並びです。PDFの要件表と、数字と区分を1行ずつ見比べてください。</p>

  <div id="total_credits_row" class="mt-3 rounded-xl border border-slate-200 bg-white px-4 py-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="text-sm font-bold text-slate-900">卒業に必要な総単位</span>
        <p class="mt-0.5 text-xs text-slate-600">この数字が低く読まれていると、足りない学生にも「卒業できます」と答えます。</p>
      </div>
      <label class="flex items-center gap-2">
        <span class="sr-only">必要な総単位</span>
        <%= rv_number 'display[total_credits]', total, id: nil, class: "w-20 text-right font-bold #{field_class}" %>
        <span class="text-xs text-slate-500">単位以上</span>
      </label>
    </div>
    <%= render 'requirements_finding_notes', findings: review.findings_for(:display, 'total_credits') %>
    <%= render 'requirements_problems', review: review, kind: 'total', id: 'total' %>
  </div>

  <div class="mt-3 space-y-3">
    <% review.groups.each_with_index do |group, group_index| %>
      <% group_key = "display[groups][#{group_index}]" %>
      <section id="group-<%= group['id'] %>" class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5">
            <%= hidden_field_tag "#{group_key}[id]", group['id'], id: nil %>
            <label class="block">
              <span class="sr-only">章の名前</span>
              <%= rv_text "#{group_key}[title]", group['title'], id: nil,
                          class: "w-64 font-bold text-slate-900 #{field_class}" %>
            </label>
            <% if human_confirmed?(group) %><span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
          </div>
          <label class="flex items-center gap-2">
            <span class="text-xs font-medium text-slate-500">章の必要単位</span>
            <%= rv_number "#{group_key}[required_credits]", group['required_credits'], id: nil,
                          class: "w-20 text-right font-bold #{field_class}" %>
            <span class="text-xs text-slate-500">単位以上</span>
          </label>
        </div>

        <div class="mt-2 flex flex-wrap items-end gap-3 text-xs">
          <label class="block"><span class="font-semibold text-slate-700">確認する規則(id)</span>
            <%= rv_text "#{group_key}[check_id]", group['check_id'], id: nil, class: "mt-1 block w-48 #{field_class}" %></label>
          <label class="block"><span class="font-semibold text-slate-700">並び(小さい順)</span>
            <%= rv_number "#{group_key}[position]", group_index + 1, id: nil, class: "mt-1 block w-20 #{field_class}" %></label>
          <label class="flex items-center gap-1.5 text-rose-800">
            <%= rv_check "#{group_key}[_destroy]", '1', false, id: nil %>
            この章を消す(読み直しても戻りません。行も一緒に消えます)
          </label>
        </div>

        <%= render 'requirements_finding_notes', findings: review.findings_for(:display, group['id']) %>
        <%= render 'requirements_problems', review: review, kind: 'group', id: group['id'] %>

        <%# 入れ子を持つ規則(AND/OR)だけ、枠にして出す。残りは id のリンクだけ(規則の一覧で直す)。 %>
        <div class="mt-2 text-xs">
          <span class="font-semibold text-slate-700">確認する規則:</span>
          <%= render 'requirements_rule_links', review: review, ids: Array.wrap(group['check_id']) %>
        </div>
        <% nested = nested_rule_boxes(group['check_id'], review) %>
        <% if nested.any? %>
          <div class="mt-2 space-y-2">
            <% nested.each do |rule| %>
              <%= render 'requirements_rule_box', review: review, rule: rule %>
            <% end %>
          </div>
        <% end %>

        <div class="mt-4 ml-4 space-y-3 border-l-2 border-indigo-200 pl-4">
          <% review.rows_of(group).each_with_index do |row, row_index| %>
            <%= render 'requirements_row', review: review, row: row, row_key: "#{group_key}[rows][#{row_index}]", row_index: row_index %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <%= render 'requirements_subtotals', review: review %>
</div>
