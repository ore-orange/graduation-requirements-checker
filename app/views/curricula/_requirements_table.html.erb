<%# 区分ごとの必要単位の表。AI が読んだ「画面の表」(display)の章と行をそのまま並べる。読むための表で、直す欄は各行の「直す」の中。 %>
<% total = review.display['total_credits'] %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_table">
  <h4 class="text-sm font-bold text-slate-900">区分ごとの必要単位</h4>
  <p class="mt-0.5 text-xs text-slate-500">学生の画面に出る表と同じ並びです。PDFの要件表と、数字と区分を1行ずつ見比べてください。</p>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[40rem] text-sm">
      <caption class="sr-only">区分ごとの必要単位</caption>
      <thead class="bg-slate-100 text-left text-xs text-slate-700">
        <tr>
          <th scope="col" class="px-2 py-2">項目</th>
          <th scope="col" class="w-24 px-2 py-2">必要単位</th>
          <th scope="col" class="px-2 py-2">数える区分</th>
          <th scope="col" class="px-2 py-2">確認する規則</th>
        </tr>
      </thead>

      <tbody id="total_credits_row" class="border-b border-slate-200">
        <tr class="bg-slate-50 font-bold text-slate-900">
          <th scope="row" class="px-2 py-2 text-left">卒業に必要な総単位</th>
          <td class="px-2 py-2 tabular-nums"><%= review_credits(total) %></td>
          <td colspan="2" class="px-2 py-2 text-xs font-normal text-slate-600">
            この数字が低く読まれていると、足りない学生にも「卒業できます」と答えます。
          </td>
        </tr>
        <tr>
          <td colspan="4" class="px-2 pb-2">
            <%= render 'requirements_finding_notes', findings: review.findings_for(:display, 'total_credits') %>
            <details class="mt-1">
              <summary class="cursor-pointer text-xs font-semibold text-slate-700">総単位を直す</summary>
              <label class="mt-2 flex items-center gap-2 text-sm">
                <span class="text-xs font-semibold text-slate-700">必要な総単位</span>
                <%= number_field_tag 'display[total_credits]', total, step: 'any', id: nil, class: "w-28 #{field_class}" %>
              </label>
            </details>
          </td>
        </tr>
      </tbody>

      <% review.groups.each_with_index do |group, group_index| %>
        <% group_key = "display[groups][#{group_index}]" %>
        <tbody id="group-<%= group['id'] %>" class="border-b border-slate-200">
          <tr class="bg-slate-50 font-bold text-slate-900">
            <th scope="row" class="px-2 py-2 text-left">
              <%= group['title'] %> 合計
              <% if human_confirmed?(group) %><span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
            </th>
            <td class="px-2 py-2 tabular-nums"><%= review_credits(group['required_credits']) %></td>
            <td class="px-2 py-2"></td>
            <td class="px-2 py-2 text-xs font-normal">
              <%= render 'requirements_rule_links', review: review, ids: Array.wrap(group['check_id']) %>
            </td>
          </tr>
          <tr>
            <td colspan="4" class="px-2 pb-2">
              <%= render 'requirements_finding_notes', findings: review.findings_for(:display, group['id']) %>
              <details class="mt-1">
                <summary class="cursor-pointer text-xs font-semibold text-slate-700">この章を直す・並べ替える・消す</summary>
                <div class="mt-2 flex flex-wrap items-end gap-3">
                  <%= hidden_field_tag "#{group_key}[id]", group['id'], id: nil %>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">章の名前</span>
                    <%= text_field_tag "#{group_key}[title]", group['title'], id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位</span>
                    <%= number_field_tag "#{group_key}[required_credits]", group['required_credits'], step: 'any', id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">確認する規則(id)</span>
                    <%= text_field_tag "#{group_key}[check_id]", group['check_id'], id: nil, class: "mt-1 block w-48 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">並び(小さい順)</span>
                    <%= number_field_tag "#{group_key}[position]", group_index + 1, step: 'any', id: nil, class: "mt-1 block w-20 #{field_class}" %></label>
                  <label class="flex items-center gap-1.5 text-xs text-rose-800">
                    <%= check_box_tag "#{group_key}[_destroy]", '1', false, id: nil %>
                    この章を消す(読み直しても戻りません。行も一緒に消えます)
                  </label>
                </div>
              </details>
            </td>
          </tr>

          <% review.rows_of(group).each_with_index do |row, row_index| %>
            <% row_key = "#{group_key}[rows][#{row_index}]" %>
            <tr id="row-<%= row['id'] %>" class="align-top">
              <td class="px-2 py-2 pl-5">
                <p class="font-semibold text-slate-900">
                  <%= row['name'] %>
                  <% if human_confirmed?(row) %><span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
                </p>
                <% if row['subtitle'].present? %><p class="text-xs text-slate-600"><%= row['subtitle'] %></p><% end %>
              </td>
              <td class="px-2 py-2 tabular-nums">
                <% if row['required_credits'].is_a?(Numeric) %>
                  <%= review_credits(row['required_credits']) %>
                <% else %>
                  <span class="text-xs text-slate-700"><%= row['required_label'].presence || '—' %></span>
                <% end %>
              </td>
              <td class="px-2 py-2 text-xs text-slate-800">
                <%= Array.wrap(row['categories']).map { |key| review.category_label(key) }.join('・').presence || '(区分なし)' %>
                <% if row['credits_from_check'] == true %><span class="block text-slate-500">単位は確認する規則から取る</span><% end %>
              </td>
              <td class="px-2 py-2 text-xs">
                <%= render 'requirements_rule_links', review: review, ids: Array.wrap(row['check_ids']) %>
              </td>
            </tr>
            <tr>
              <td colspan="4" class="px-2 pb-2 pl-5">
                <%= render 'requirements_finding_notes', findings: review.findings_for(:display, row['id']) %>
                <details class="mt-1">
                  <summary class="cursor-pointer text-xs font-semibold text-slate-700">この行を直す・並べ替える・消す</summary>
                  <div class="mt-2 flex flex-wrap items-end gap-3">
                    <%= hidden_field_tag "#{row_key}[id]", row['id'], id: nil %>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">名前</span>
                      <%= text_field_tag "#{row_key}[name]", row['name'], id: nil, class: "mt-1 block w-56 #{field_class}" %></label>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">副題</span>
                      <%= text_field_tag "#{row_key}[subtitle]", row['subtitle'], id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位(内数なら空)</span>
                      <%= number_field_tag "#{row_key}[required_credits]", row['required_credits'], step: 'any', id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位が空のときの表示</span>
                      <%= text_field_tag "#{row_key}[required_label]", row['required_label'], id: nil, class: "mt-1 block w-48 #{field_class}" %></label>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">確認する規則(id をカンマで区切る)</span>
                      <%= text_field_tag "#{row_key}[check_ids]", Array.wrap(row['check_ids']).join(', '), id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
                    <label class="block"><span class="text-xs font-semibold text-slate-700">並び(小さい順)</span>
                      <%= number_field_tag "#{row_key}[position]", row_index + 1, step: 'any', id: nil, class: "mt-1 block w-20 #{field_class}" %></label>
                    <label class="flex items-center gap-1.5 text-xs text-slate-800">
                      <%= hidden_field_tag "#{row_key}[credits_from_check]", '0', id: nil %>
                      <%= check_box_tag "#{row_key}[credits_from_check]", '1', row['credits_from_check'] == true, id: nil %>
                      単位を確認する規則から取る
                    </label>
                    <label class="flex items-center gap-1.5 text-xs text-rose-800">
                      <%= check_box_tag "#{row_key}[_destroy]", '1', false, id: nil %>
                      この行を消す(読み直しても戻りません)
                    </label>
                  </div>
                  <div class="mt-2">
                    <span class="text-xs font-semibold text-slate-700">数える区分</span>
                    <%= category_checks "#{row_key}[categories]", row['categories'], review %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>

  <% if review.subtotals.any? %>
    <h4 class="mt-6 text-sm font-bold text-slate-900">小計</h4>
    <ul class="mt-2 space-y-2" id="requirements_subtotals">
      <% review.subtotals.each_with_index do |subtotal, index| %>
        <% key = "display[subtotals][#{index}]" %>
        <li id="subtotal-<%= subtotal['id'] %>" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
          <p class="font-semibold text-slate-900">
            <%= subtotal['name'] %> <span class="tabular-nums"><%= review_credits(subtotal['required_credits']) %>単位</span>
            <% if human_confirmed?(subtotal) %><span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
          </p>
          <p class="text-xs text-slate-600">
            行: <%= Array.wrap(subtotal['row_ids']).join('・').presence || '(なし)' %> /
            規則: <%= render 'requirements_rule_links', review: review, ids: Array.wrap(subtotal['check_ids']) %>
          </p>
          <%= render 'requirements_finding_notes', findings: review.findings_for(:display, subtotal['id']) %>
          <details class="mt-1">
            <summary class="cursor-pointer text-xs font-semibold text-slate-700">この小計を直す・消す</summary>
            <div class="mt-2 flex flex-wrap items-end gap-3">
              <%= hidden_field_tag "#{key}[id]", subtotal['id'], id: nil %>
              <label class="block"><span class="text-xs font-semibold text-slate-700">名前</span>
                <%= text_field_tag "#{key}[name]", subtotal['name'], id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
              <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位</span>
                <%= number_field_tag "#{key}[required_credits]", subtotal['required_credits'], step: 'any', id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
              <label class="block"><span class="text-xs font-semibold text-slate-700">数える行(id をカンマで区切る)</span>
                <%= text_field_tag "#{key}[row_ids]", Array.wrap(subtotal['row_ids']).join(', '), id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
              <label class="block"><span class="text-xs font-semibold text-slate-700">確認する規則(id をカンマで区切る)</span>
                <%= text_field_tag "#{key}[check_ids]", Array.wrap(subtotal['check_ids']).join(', '), id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
              <label class="flex items-center gap-1.5 text-xs text-rose-800">
                <%= check_box_tag "#{key}[_destroy]", '1', false, id: nil %>
                この小計を消す(読み直しても戻りません)
              </label>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
