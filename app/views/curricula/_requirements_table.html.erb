<%# 区分ごとの必要単位の表。AI が読んだ「画面の表」(display)の章と行をそのまま並べる。読むための表で、直す欄は各行の「直す」の中。 %>
<% total = review.display['total_credits'] %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_table">
  <h4 class="text-sm font-bold text-slate-900">区分ごとの必要単位</h4>
  <p class="mt-0.5 text-xs text-slate-500">学生の画面に出る表と同じ並びです。PDFの要件表と、数字と区分を1行ずつ見比べてください。</p>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[40rem] text-sm">
      <caption class="sr-only">区分ごとの必要単位</caption>
      <thead class="bg-slate-100 text-left text-xs text-slate-700">
        <tr>
          <th scope="col" class="px-2 py-2">項目</th>
          <th scope="col" class="w-24 px-2 py-2">必要単位</th>
          <th scope="col" class="px-2 py-2">数える区分</th>
          <th scope="col" class="px-2 py-2">確認する規則</th>
        </tr>
      </thead>

      <tbody id="total_credits_row" class="border-b border-slate-200">
        <tr class="bg-slate-50 font-bold text-slate-900">
          <th scope="row" class="px-2 py-2 text-left">卒業に必要な総単位</th>
          <td class="px-2 py-2 tabular-nums"><%= review_credits(total) %></td>
          <td colspan="2" class="px-2 py-2 text-xs font-normal text-slate-600">
            この数字が低く読まれていると、足りない学生にも「卒業できます」と答えます。
          </td>
        </tr>
        <tr>
          <td colspan="4" class="px-2 pb-2">
            <%= render 'requirements_finding_notes', findings: review.findings_for(:display, 'total_credits') %>
            <%= render 'requirements_problems', review: review, kind: 'total', id: 'total' %>
            <details class="mt-1" <%= 'open' if review.open?('total', 'total') %>>
              <summary class="cursor-pointer text-xs font-semibold text-slate-700">総単位を直す</summary>
              <label class="mt-2 flex items-center gap-2 text-sm">
                <span class="text-xs font-semibold text-slate-700">必要な総単位</span>
                <%= rv_number 'display[total_credits]', total, id: nil, class: "w-28 #{field_class}" %>
              </label>
            </details>
          </td>
        </tr>
      </tbody>

      <% review.groups.each_with_index do |group, group_index| %>
        <% group_key = "display[groups][#{group_index}]" %>
        <tbody id="group-<%= group['id'] %>" class="border-b border-slate-200">
          <tr class="bg-slate-50 font-bold text-slate-900">
            <th scope="row" class="px-2 py-2 text-left">
              <%= group['title'] %> 合計
              <% if human_confirmed?(group) %><span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">人が確認した</span><% end %>
            </th>
            <td class="px-2 py-2 tabular-nums"><%= review_credits(group['required_credits']) %></td>
            <td class="px-2 py-2"></td>
            <td class="px-2 py-2 text-xs font-normal">
              <%= render 'requirements_rule_links', review: review, ids: Array.wrap(group['check_id']) %>
            </td>
          </tr>
          <tr>
            <td colspan="4" class="px-2 pb-2">
              <%= render 'requirements_finding_notes', findings: review.findings_for(:display, group['id']) %>
              <%= render 'requirements_problems', review: review, kind: 'group', id: group['id'] %>
              <details class="mt-1" <%= 'open' if review.open?('group', group['id']) %>>
                <summary class="cursor-pointer text-xs font-semibold text-slate-700">この章を直す・並べ替える・消す</summary>
                <div class="mt-2 flex flex-wrap items-end gap-3">
                  <%= hidden_field_tag "#{group_key}[id]", group['id'], id: nil %>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">章の名前</span>
                    <%= rv_text "#{group_key}[title]", group['title'], id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位</span>
                    <%= rv_number "#{group_key}[required_credits]", group['required_credits'], id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">確認する規則(id)</span>
                    <%= rv_text "#{group_key}[check_id]", group['check_id'], id: nil, class: "mt-1 block w-48 #{field_class}" %></label>
                  <label class="block"><span class="text-xs font-semibold text-slate-700">並び(小さい順)</span>
                    <%= rv_number "#{group_key}[position]", group_index + 1, id: nil, class: "mt-1 block w-20 #{field_class}" %></label>
                  <label class="flex items-center gap-1.5 text-xs text-rose-800">
                    <%= rv_check "#{group_key}[_destroy]", '1', false, id: nil %>
                    この章を消す(読み直しても戻りません。行も一緒に消えます)
                  </label>
                </div>
              </details>
            </td>
          </tr>

          <% review.rows_of(group).each_with_index do |row, row_index| %>
            <%= render 'requirements_row', review: review, row: row, row_key: "#{group_key}[rows][#{row_index}]", row_index: row_index %>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>

  <%= render 'requirements_subtotals', review: review %>
</div>
