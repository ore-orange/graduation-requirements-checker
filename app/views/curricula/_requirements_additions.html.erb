<%# AI が読み落とした章・行を、人が足す。足したものは「人が確認した」印が付き、読み直しで消えない。 %>
<%# 規則の id は人が打たない(設計書 項目5)。足した章・行を確かめる決まりは、下の「決まりを足す」で %>
<%# 種類と欄を書き、「結びつける先」でこの章・行を名前で選ぶ。id はアプリが裏で振る。 %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<div id="requirements_additions" class="space-y-3">
  <div id="new_group" class="rounded-lg border border-dashed border-slate-300 px-3 py-2">
    <p class="text-xs font-semibold text-slate-700">＋ 章を足す(表に出ていない章がある)</p>
    <%= render 'requirements_problems', review: review, kind: 'new_group', id: 'new' %>
    <div class="mt-2 flex flex-wrap items-end gap-3">
      <label class="block"><span class="text-xs font-semibold text-slate-700">章の名前</span>
        <%= rv_text 'new_group[title]', nil, id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位</span>
        <%= rv_number 'new_group[required_credits]', nil, id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
    </div>
  </div>

  <div id="new_row" class="rounded-lg border border-dashed border-slate-300 px-3 py-2">
    <p class="text-xs font-semibold text-slate-700">＋ 行を足す(章の中に出ていない区分がある)</p>
    <%= render 'requirements_problems', review: review, kind: 'new_row', id: 'new' %>
    <div class="mt-2 flex flex-wrap items-end gap-3">
      <label class="block"><span class="text-xs font-semibold text-slate-700">足す章</span>
        <%= rv_select 'new_row[group_id]', review.groups.map { |group| [group['title'], group['id']] }, nil, include_blank: '選んでください',
                      id: nil, class: "mt-1 block #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">名前</span>
        <%= rv_text 'new_row[name]', nil, id: nil, class: "mt-1 block w-56 #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">副題</span>
        <%= rv_text 'new_row[subtitle]', nil, id: nil, class: "mt-1 block w-64 #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位(内数なら空)</span>
        <%= rv_number 'new_row[required_credits]', nil, id: nil, class: "mt-1 block w-24 #{field_class}" %></label>
      <label class="block"><span class="text-xs font-semibold text-slate-700">必要単位が空のときの表示</span>
        <%= rv_text 'new_row[required_label]', nil, id: nil, class: "mt-1 block w-48 #{field_class}" %></label>
      <label class="flex items-center gap-1.5 text-xs text-slate-800">
        <%= hidden_field_tag 'new_row[credits_from_check]', '0', id: nil %>
        <%= rv_check 'new_row[credits_from_check]', '1', false, id: nil %>
        単位を確認する規則から取る
      </label>
    </div>
    <%= category_chips 'new_row[categories]', [], review %>
  </div>
</div>
