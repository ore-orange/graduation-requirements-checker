<%# any_of の選択肢・all_of の条件を1つ。種類を選び、その種類が持つ欄を出す。 %>
<%# all_of を選んだ条件は、その中の条件をもう1段だけ、同じ部分テンプレートで出す(入れ子は2階層まで)。 %>
<%# key は欄の名前の前半(例: rules[3][options][0])。allowed は、ここに置ける種類。 %>
<% field_class = RequirementsReviewHelper::FIELD_CLASS %>
<% type = condition['type'] %>
<div data-repeater-target="row" data-condition-type="<%= type %>"
     class="space-y-2 rounded-lg border border-slate-200 bg-white px-2.5 py-2">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <label class="flex items-center gap-2">
      <span class="text-xs font-bold text-slate-700">種類</span>
      <%= rv_select "#{key}[type]", allowed.map { |value| [rule_type_name(value), value] }, type,
                    id: nil, class: "text-xs #{field_class}" %>
    </label>
    <button type="button" data-action="click->repeater#remove"
            class="text-xs text-slate-400 hover:text-rose-600">この条件を消す</button>
  </div>

  <div class="grid gap-2 sm:grid-cols-2">
    <% CurriculumImport::RequirementsEdit.condition_fields(type).each do |field, kind| %>
      <div class="<%= 'sm:col-span-2' if kind == :set %>">
        <%= rule_field_input "#{key}[#{field}]", field, kind, condition, review %>
      </div>
    <% end %>
  </div>

  <% if type == 'all_of' %>
    <% inner = GraduationAssessment::Rules::ALL_OF_CONDITIONS %>
    <div data-controller="repeater" class="ml-2 border-l-2 border-slate-200 pl-2">
      <p class="text-xs font-bold text-slate-700">すべて満たす条件</p>
      <div data-repeater-target="list" class="mt-1 space-y-2">
        <% Array(condition['conditions']).grep(Hash).each_with_index do |child, child_index| %>
          <%= render 'requirements_rule_condition', review: review, condition: child, allowed: inner,
                     key: "#{key}[conditions][#{child_index}]" %>
        <% end %>
      </div>
      <template data-repeater-target="template">
        <%= render 'requirements_rule_condition', review: review, condition: { 'type' => inner.first },
                   allowed: inner, key: "#{key}[conditions][__INDEX__]" %>
      </template>
      <button type="button" data-action="click->repeater#add"
              class="mt-2 text-xs font-semibold text-indigo-600 hover:text-indigo-800">＋ 条件を足す</button>
    </div>
  <% end %>
</div>
