<section class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs" aria-labelledby="<%= kind %>-heading" data-assessment="<%= kind %>" data-status="<%= snapshot.status %>" data-counted-credits="<%= snapshot.counted_credits %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 id="<%= kind %>-heading" class="text-base font-bold text-slate-900"><%= heading %></h3>
      <p class="mt-0.5 text-xs text-slate-500"><%= description %></p>
    </div>
    <span class="demo-status <%= assessment_status_class(snapshot.status) %>"><%= assessment_status_label(snapshot.status) %></span>
  </div>
  <div class="mt-4 flex items-baseline gap-2">
    <span class="text-xs font-medium text-slate-500">卒業算入単位:</span>
    <span class="text-2xl font-extrabold text-slate-900"><%= credit_label(snapshot.counted_credits) %></span>
  </div>
  <% if snapshot.review_notes.any? %>
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50/70 p-3.5">
      <h4 class="text-xs font-bold text-amber-900">確認が必要な項目</h4>
      <ul class="mt-1.5 list-disc space-y-1 pl-4 text-xs text-amber-900">
        <% snapshot.review_notes.each do |note| %><li><%= note %></li><% end %>
      </ul>
    </div>
  <% end %>
  <details class="mt-4 space-y-2.5 border-t border-slate-100 pt-3" data-assessment-details>
    <summary class="cursor-pointer text-xs font-semibold text-indigo-600 hover:text-indigo-800">区分ごとの判定・不足科目を確認</summary>
    <div class="mt-2.5 space-y-2">
      <% snapshot.checks.each do |check| %>
        <article class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-3" data-check="<%= check.id %>" data-status="<%= check.status %>">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h4 class="text-xs font-bold text-slate-800"><%= check.label %></h4>
            <span class="demo-status <%= assessment_status_class(check.status) %>"><%= assessment_status_label(check.status) %></span>
          </div>
          <% unless check.required_credits.nil? %>
            <p class="mt-1 text-xs text-slate-600">算入 <%= credit_label(check.counted_credits) %> / 必要 <%= credit_label(check.required_credits) %></p>
          <% end %>
          <% if check.missing_courses.any? %>
            <p class="mt-1 text-xs text-rose-700 font-medium"><%= check.status == :needs_review ? '確認が必要な科目' : '未充足の科目' %>: <%= check.missing_courses.join('、') %></p>
          <% end %>
          <% if check.detail.present? %><p class="mt-1 text-xs leading-5 text-slate-600"><%= check.detail %></p><% end %>
        </article>
      <% end %>
    </div>
  </details>
  <details class="mt-3 border-t border-slate-100 pt-3">
    <summary class="cursor-pointer text-xs font-semibold text-slate-600 hover:text-slate-900">科目ごとの算入内訳を確認 (<%= snapshot.course_results.size %>科目)</summary>
    <ul class="mt-2.5 divide-y divide-slate-100 max-h-64 overflow-y-auto pr-1">
      <% snapshot.course_results.each do |course| %>
        <li class="py-2 text-xs flex flex-wrap items-center justify-between gap-2">
          <div>
            <span class="font-semibold text-slate-800"><%= course.name %></span>
            <span class="ml-2 text-slate-500"><%= course.reason %></span>
          </div>
          <span class="font-mono text-slate-700">算入 <%= credit_label(course.counted_credits) %> <span class="text-slate-400">(科目 <%= credit_label(course.credits) %>)</span></span>
        </li>
      <% end %>
    </ul>
  </details>
</section>
