<% content_for :title, "ローカルデモ | #{app_name}" %>
<div class="space-y-8">
  <header>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <%= link_to app_name, root_path, class: 'text-sm font-semibold text-slate-700 underline underline-offset-4' %>
      <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-bold tracking-wider text-white">LOCAL DEMO</span>
    </div>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"><%= app_name %></h1>
    <p class="mt-3 text-slate-600">2024 年度入学・知能情報コース / 履修計画シミュレーション</p>
    <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm leading-7 text-amber-950">
      <p class="font-bold">人工の履修データを使うローカル専用デモです。</p>
      <p>表示される学生・成績・履修状況は大学の実データではありません。卒業の最終認定ではなく、出典に基づく要件確認の補助です。未確認の情報は「要確認」として表示します。</p>
      <p>修得済み・履修中の記録は変更できません。今後の履修予定だけを追加・削除でき、操作のたびにこのデモ学生のデータベースへ保存します。</p>
    </div>
  </header>

  <% if flash[:notice] %><p role="status" class="rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-950"><%= flash[:notice] %></p><% end %>
  <% if flash[:alert] %><p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-red-950"><%= flash[:alert] %></p><% end %>

  <nav aria-label="ページ内ナビゲーション" class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-slate-700">
    <a href="#assessments" class="underline underline-offset-4">判定結果</a>
    <a href="#plans" class="underline underline-offset-4">今後の履修予定</a>
    <a href="#catalogue" class="underline underline-offset-4">科目を探す</a>
    <a href="#history" class="underline underline-offset-4">履修記録</a>
    <a href="#sources" class="underline underline-offset-4">出典</a>
  </nav>

  <div id="assessments" class="grid items-start gap-6 lg:grid-cols-2">
    <%= render 'snapshot', snapshot: @assessment.actual, kind: 'actual', heading: '現在の修得状況', description: '修得済みの科目のみで判定しています。' %>
    <%= render 'snapshot', snapshot: @assessment.projected, kind: 'projected', heading: '履修予定を含めた見込み', description: '修得済み + 履修登録済み・履修中 + 今後の履修予定で判定しています。単位修得を保証するものではありません。' %>
  </div>

  <section id="plans" class="demo-panel" aria-labelledby="plans-heading">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="plans-heading" class="text-xl font-bold text-slate-900">今後の履修予定</h2>
      <span class="text-sm text-slate-600"><%= @plans.size %> 科目を保存済み</span>
    </div>
    <p class="mt-2 text-sm leading-6 text-slate-600">追加した科目は再訪時にも復元します。登録しても修得済みの記録にはなりません。個別の履修許可が必要な科目は、許可済みと仮定せず判定します。</p>
    <% if @plans.empty? %>
      <p class="mt-5 rounded-lg bg-slate-50 p-4 text-slate-600">まだ科目を追加していません。下の科目一覧から今後の履修予定を選んでください。</p>
    <% else %>
      <ul class="mt-4 divide-y divide-slate-200">
        <% @plans.each do |plan| %>
          <% course = @courses_by_key[plan.course.curriculum_key] %>
          <li class="flex flex-wrap items-center justify-between gap-4 py-4" data-plan="<%= plan.id %>" data-course-key="<%= plan.course.curriculum_key %>">
            <div>
              <h3 class="font-semibold text-slate-900"><%= plan.course.name %></h3>
              <p class="mt-1 text-sm text-slate-600"><%= category_label(course&.fetch('category') || '未分類') %> / <%= credit_label(course&.fetch('credits')) %></p>
            </div>
            <%= button_to '予定から削除', demo_planned_course_path(plan), method: :delete, class: 'demo-button-secondary', form: { class: 'shrink-0' }, aria: { label: "#{plan.course.name}を今後の履修予定から削除" } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="catalogue" class="demo-panel" aria-labelledby="catalogue-heading">
    <h2 id="catalogue-heading" class="text-xl font-bold text-slate-900">科目一覧から予定を追加</h2>
    <p class="mt-2 text-sm leading-6 text-slate-600">出典で確認できる科目を掲載しています。修得済み・履修中・追加済みの科目や選択対象外の科目は追加できません。</p>
    <%= form_with url: demo_path(anchor: 'catalogue'), method: :get, class: 'mt-5 grid items-end gap-4 sm:grid-cols-[1fr_1fr_auto]' do |form| %>
      <div>
        <%= form.label :q, '科目名・科目番号で検索', class: 'demo-label' %>
        <%= form.search_field :q, value: @query, class: 'demo-input' %>
      </div>
      <div>
        <%= form.label :category, '科目区分', class: 'demo-label' %>
        <%= form.select :category, @curriculum.fetch('courses').map { |course| course.fetch('category') }.uniq.map { |category| [category_label(category), category] }, { include_blank: 'すべての区分', selected: @category }, class: 'demo-input' %>
      </div>
      <%= form.submit '絞り込む', class: 'demo-button cursor-pointer' %>
    <% end %>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600">
      <p><%= @catalogue.size %> 科目を表示</p>
      <%= link_to '条件をリセット', demo_path(anchor: 'catalogue'), class: 'underline underline-offset-4' %>
    </div>
    <% if @catalogue.empty? %>
      <p class="mt-5 rounded-lg bg-slate-50 p-4 text-slate-600">条件に合う科目がありません。検索語や区分を変更してください。</p>
    <% else %>
      <ul class="mt-4 divide-y divide-slate-200">
        <% @catalogue.each do |course| %>
          <% unavailable = catalogue_availability(course, unavailable_keys: @unavailable_keys, persisted_keys: @persisted_keys) %>
          <li class="py-4" data-catalogue-key="<%= course.fetch('key') %>">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 flex-1 basis-56">
                <h3 class="font-semibold text-slate-900"><%= course.fetch('name') %></h3>
                <p class="mt-1 text-sm text-slate-600"><%= category_label(course.fetch('category')) %> / <%= credit_label(course['credits']) %><% if course['number'].present? %> / <%= course['number'] %><% end %></p>
                <% if course['required'] %><span class="mt-2 inline-block rounded bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">専門必修</span><% end %>
                <% if course['requires_approval'] %><p class="mt-2 text-sm text-amber-800">個別の履修許可の確認が必要です。</p><% end %>
                <% if course['review_reason'].present? %><p class="mt-2 text-sm leading-6 text-amber-800">要確認: <%= course['review_reason'] %></p><% end %>
                <p class="mt-2 text-xs text-slate-500">出典: <%= course['source'] %> / <%= course['source_page'] %></p>
              </div>
              <% if unavailable %>
                <p class="max-w-60 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-600"><%= unavailable %></p>
              <% else %>
                <%= form_with url: demo_planned_courses_path, class: 'shrink-0' do |form| %>
                  <%= form.hidden_field :course_key, value: course.fetch('key'), id: nil %>
                  <%= form.submit '予定に追加', class: 'demo-button cursor-pointer', aria: { label: "#{course.fetch('name')}を今後の履修予定に追加" } %>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div id="history" class="grid items-start gap-6 lg:grid-cols-2">
    <%= render 'enrollments', section_id: 'completed-heading', heading: '修得済み（読み取り専用）', description: 'データベースに保存された修得記録です。現在と見込みの両方に使用します。', enrollments: @completed %>
    <%= render 'enrollments', section_id: 'current-heading', heading: '履修登録済み・履修中（読み取り専用）', description: 'まだ修得していないため、見込みの判定にのみ使用します。', enrollments: @current %>
    <% if @other_enrollments.any? %>
      <%= render 'enrollments', section_id: 'other-heading', heading: 'その他の履修記録（読み取り専用）', description: '未修得の科目は算入しません。状態未確認の記録は、現在・見込みともに確認が必要な情報として扱います。', enrollments: @other_enrollments %>
    <% end %>
  </div>

  <section id="sources" class="demo-panel" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="text-xl font-bold text-slate-900">判定に使用する出典</h2>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= @curriculum['title'] %>。個別の特例・留学生向けの例外は対象外です。最新の履修要項や教務窓口で最終確認してください。</p>
    <ul class="mt-4 space-y-4 text-sm">
      <% @curriculum.fetch('sources').each do |source| %>
        <li>
          <% if source_url(source) %>
            <%= link_to source.fetch('title'), source_url(source), class: 'font-semibold text-sky-800 underline underline-offset-4', target: '_blank', rel: 'noopener noreferrer' %><span class="text-slate-500">（別タブで開きます）</span>
          <% else %>
            <span class="font-semibold text-slate-800"><%= source.fetch('title') %></span>
          <% end %>
          <p class="mt-1 text-slate-500"><%= source.fetch('id') %><% if source['pages'].present? %> / <%= source['pages'] %><% end %></p>
          <% if source['note'].present? %><p class="mt-1 leading-6 text-slate-600"><%= source['note'] %></p><% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
