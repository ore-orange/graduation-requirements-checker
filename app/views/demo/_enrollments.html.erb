<section class="demo-panel" aria-labelledby="<%= section_id %>">
  <h2 id="<%= section_id %>" class="text-xl font-bold text-slate-900"><%= heading %></h2>
  <p class="mt-2 text-sm leading-6 text-slate-600"><%= description %></p>
  <% if enrollments.empty? %>
    <p class="mt-4 text-sm text-slate-500">該当する科目はありません。</p>
  <% else %>
    <ul class="mt-4 divide-y divide-slate-200">
      <% enrollments.each do |enrollment| %>
        <li class="py-3" data-enrollment="<%= enrollment.id %>">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h3 class="font-medium text-slate-900"><%= enrollment.course.name %></h3>
            <span class="text-sm text-slate-600"><%= enrollment_status_label(enrollment.enrollment_status) %></span>
          </div>
          <p class="mt-1 text-sm text-slate-600">
            <%= enrollment.academic_year %> 年度 / <%= enrollment.semester %> / <%= credit_label(enrollment.assessment_entry[:credits]) %>
          </p>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
