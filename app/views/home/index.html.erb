<% content_for :title, app_name %>
<div class="mx-auto max-w-2xl text-center">
  <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
    <%= app_name %>
  </h1>

  <p class="mt-6 text-lg leading-8 text-gray-600">
    履修計画を入力すると、卒業要件を満たしているかを判定します。
  </p>

  <p class="mt-2 text-sm text-gray-500">
    琉球大学 工学部 工学科 知能情報コース
  </p>

  <% if local_demo_access? %>
    <p class="mt-8">
      <%= link_to 'ローカルデモで履修計画を試す', demo_path, class: 'demo-button' %>
    </p>
    <p class="mt-3 text-sm text-gray-500">人工の履修データを使用します。大学による卒業認定ではありません。</p>
  <% end %>
</div>
